{
    "name": "agrcms/proto",
    "description": "WxT based intranet sub project.",
    "type": "project",
    "license": "GPL-2.0+",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "package",
            "package": {
                "name": "agrcms/behatags",
                "version": "1.0.4",
                "type": "agrcms-library",
                "source": {
                    "url": "https://gitlab.com/agrcms/behatags.git",
                    "type": "git",
                    "reference": "master"
                }
            }
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        {
            "type": "composer",
            "url": "https://drupalwxt.github.io/composer-extdeps/"
        },
        {
            "type": "path",
            "url": "custom/modules/idol_feed_api"
        },
        {
            "type": "path",
            "url": "custom/modules/agri_admin"
        },
        {
            "type": "path",
            "url": "custom/modules/agri_reports"
        },
        {
            "type": "path",
            "url": "custom/modules/linkchecks"
        },
        {
            "type": "path",
            "url": "custom/modules/news_empl"
        },
        {
            "type": "path",
            "url": "custom/modules/news_bulletin"
        },
        {
            "type": "path",
            "url": "custom/modules/prefer_latest_content"
        },
        {
            "type": "path",
            "url": "custom/modules/wxt_overrides"
        },
        {
            "type": "path",
            "url": "custom/themes/grstheme_bootstrap"
        },
        {
            "type": "path",
            "url": "custom/config"
        },
        {
            "type": "package",
            "package": {
                "name": "cdubz/ckeditor5-source-editing-codemirror",
                "version": "35.1.0",
                "type": "drupal-library",
                "extra": {
                    "installer-name": "ckeditor5-source-editing-codemirror"
                },
                "dist": {
                    "url": "https://registry.npmjs.org/@cdubz/ckeditor5-source-editing-codemirror/-/ckeditor5-source-editing-codemirror-35.1.0.tgz",
                    "type": "tar"
                },
                "require": {
                    "composer/installers": "^1 || ^2"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "codemirror/codemirror",
                "version": "5.65.12",
                "type": "drupal-library",
                "extra": {
                    "installer-name": "codemirror"
                },
                "dist": {
                    "url": "https://registry.npmjs.org/codemirror/-/codemirror-5.65.12.tgz",
                    "type": "tar"
                },
                "require": {
                    "composer/installers": "^1 || ^2"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "drupaloverride/webform_revision_ui",
                "version": "dev-master",
                "type": "drupal-module",
                "source": {
                    "url": "https://git.drupalcode.org/issue/webform_revision_ui-3435672",
                    "type": "git",
                    "reference": "project-update-bot-only"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "nnnick/chartjs",
                "version": "v4.4.7",
                "type": "drupal-library",
                "extra": {
                    "installer-name": "chartjs/dist"
                },
                "dist": {
                    "url": "https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js",
                    "type": "file"
                },
                "require": {
                    "composer/installers": "*"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "fontawesome/fontawesome",
                "version": "6.4.2",
                "type": "drupal-library",
                "extra": {
                    "installer-name": "fontawesome"
                },
                "dist": {
                    "url": "https://use.fontawesome.com/releases/v6.4.2/fontawesome-free-6.4.2-web.zip",
                    "type": "zip"
                }
            }
        }

    ],
    "scripts": {
        "post-root-package-install": [
            "DrupalWxT\\WxT\\ScriptHandler::postCreateProject"
        ],
        "pre-install-cmd": [
            "if [ -d html/sites/default ]; then chmod 775 html/sites/default; fi; rm tests/behatags/.gitignore -f;"
        ],
        "pre-update-cmd": [
            "rm tests/behatags/.gitignore -f;"
        ],
        "post-install-cmd": [
            "rm tests/behatags/.gitignore -f;bash post_install.sh"
        ],
        "post-update-cmd": [
            "bash post_install.sh"
        ],
        "quick-start": [
            "composer install"
        ]
    },
    "require-dev": {
        "agrcms/behatags": "^1.0.0",
        "drupal/coder": "^8.3.7",
        "phpmd/phpmd": "@stable",
        "mikey179/vfsstream": "~1.2",
        "squizlabs/php_codesniffer": "^3.3"
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "html/modules/contrib/webform/composer.libraries.json",
                "html/modules/contrib/ckeditor_codemirror/composer.libraries.json"
            ]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "html/"
            }
        },
        "installer-types": [
          "bower-asset",
          "npm-asset",
          "custom-module",
          "agrcms-library",
          "custom-theme"
        ],
        "installer-paths": {
            "html/core": [
                "type:drupal-core"
            ],
            "html/libraries/{$name}" : [
                "type:drupal-console-library",
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "html/modules/custom/{$name}": [
                "drupal/wxt_library",
                "type:drupal-custom-module"
            ],
            "html/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "tests/{$name}": [
               "type:agrcms-library"
            ],
            "html/profiles/{$name}": [
                "type:drupal-profile"
            ],
            "html/themes/custom/{$name}": [
                "drupal/wxt_bootstrap",
                "type:drupal-custom-theme"
            ],
            "html/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/contrib/{$name}": [
                "type:drupal-drush"
            ]
        },
        "composer-exit-on-patch-failure": true,
        "enable-patching": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/core": {
                "core breadcrumb empty patch": "build/core_breadcrumb_empty.patch"
            },
            "drupal/content_lock": {
                "Our custom patch for content_lock agrcms/d8#902": "build/content_lock.patch"
            },
            "drupal/filebrowser": {
                "3512119 - Backwards/forwards compatibility fix with camel case property names in the latest Filebrowser class, prevents dynamic properties deprecated notice.":
                "https://git.drupalcode.org/project/filebrowser/-/merge_requests/12.patch"
            },
            "drupal/safedelete": {
                "3320470 - Allow override of the bulk operation validation with a checkbox":
                "https://www.drupal.org/files/issues/2022-12-02/make-bulk-publish-verification-configurable-3320470-06.patch"
            },
            "drupal/entity_translation_unified_form": {
                "ETUF workaround is temporary, figure this out, why agrisource no issue, but AAFC has issue?":
                "build/etuf-why-this-cause-agrisource-no-issue.patch"
            },
            "drupalwxt/wxt": {
                "Allow split of password policy":
                "build/wxt_split_password_policy.patch"
            },
            "wet-boew/wet-boew": {
                "Fix flot charts for jQuery4": "build/wet-boew-fix-flot-charts-jquery4.patch"
            }
        },
        "patches-ignore": {
            "drupalwxt/wxt": {
                "drupal/linkit": {
                    "3078075 - Detect and strip base URL from pasted URLs":
                    "https://www.drupal.org/files/issues/2025-07-02/linkit-detect-strip-base-url-3078075-118.patch"
                }
            },
            "agrcmsx/dxbase": {
                "drupal/page_manager": {
                    "Enter drupal/page_manager patch #2752227 description here":
                    "https://www.drupal.org/files/issues/2018-07-05/page_manager-incorrect-page_title-2752227-32-8.x.4.x.patch"
                },
                "drupal/webform": {
                    "Enter drupal/webform patch #3212867 description here": "https://www.drupal.org/files/issues/2021-05-07/3212867-3.patch"
                }
            }
        }
    },
    "require": {
        "agrcmsx/dxbase": "11.1.3.8",
        "agrcms/agri_admin": "*",
        "agrcms/agri_reports": "*",
        "agrcms/config": "*",
        "agrcms/grstheme_bootstrap": "*",
        "agrcms/linkchecks": "*",
        "agrcms/news_empl": "*",
        "agrcms/news_bulletin": "*",
        "agrcms/wxt_overrides": "*",
        "agrcms/prefer_latest_content": "*",
        "drupal/votingapi": "4.0.x-dev as 3.0.1",
        "junhuang/idol_feed_api": "*",
        "oomphinc/composer-installers-extender": "^1 || ^2",
        "w8tcha/ckeditor-codemirror": "*",
        "wikimedia/composer-merge-plugin": "^2.1",
        "nnnick/chartjs": "^4.4",
        "drupal/cache_control_override": "^2.0",
        "drupal/ckeditor5_label_fix": "^1.0@beta",
        "drupal/ckeditor5_sup_fix": "^1.0@beta",
        "drupal/search_api_solr": "4.x-dev#fed1c8be",
        "drupal/search_api_autocomplete": "^1.10",
        "drupal/facets": "^3.0"
    },
    "authors": [
        {
            "name": "olstjos",
            "email": "j@7pro.ca"
        }
    ],
    "autoload": {
        "classmap": [
            "scripts/ScriptHandler.php"
        ]
    },
    "config": {
        "secure-http": false,
        "prestissimo": {
            "maxConnections": 10,
            "minConnections": 5
        },
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "oomphinc/composer-installers-extender": true,
            "drupal/console-extend-plugin": true,
            "drupal/core-composer-scaffold": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "wikimedia/composer-merge-plugin": true,
            "php-http/discovery": true
        }
    }
}
