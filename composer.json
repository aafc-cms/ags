{
    "name": "drupalwxt/site-wxt",
    "description": "Project template for Drupal 8 sites built with the WxT distribution.",
    "type": "project",
    "license": "GPL-2.0+",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "behat/behat": "^3.0",
        "behat/mink": "~1.7",
        "behat/mink-extension": "*",
        "behat/mink-goutte-driver": "*",
        "behat/mink-selenium2-driver": "*",
        "composer/composer": "^1.4",
        "drupal/coder": "^8.3.7",
        "drupal/console": "~1.9.0",
        "drupal/drupal-extension": "~3.4.0",
        "pdepend/pdepend": "2.1.0",
        "phpmd/phpmd": "@stable",
        "phpunit/phpunit": "^4.8.35 || ^6.1",
        "jcalderonzumba/gastonjs": "~1.0.2",
        "jcalderonzumba/mink-phantomjs-driver": "~0.3.1",
        "mikey179/vfsstream": "~1.2",
        "sebastian/phpcpd": "*",
        "squizlabs/php_codesniffer": "3.*",
        "symfony/css-selector": "~2.8|~3.0",
        "symfony/phpunit-bridge": "^3.4.3"
    },
    "config": {
        "secure-http": false,
        "prestissimo": {
            "maxConnections": 10,
            "minConnections": 5
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        {
            "type": "composer",
            "url": "https://drupalwxt.github.io/composer-extdeps/"
        },
        {
            "type": "path",
            "url": "custom/modules/idol_feed_api"
        },
        {
            "type": "path",
            "url": "custom/modules/agri_admin"
        },
        {
            "type": "path",
            "url": "custom/themes/grstheme_bootstrap"
        },
        {
            "type": "path",
            "url": "custom/config"
        }
    ],
    "scripts": {
        "post-root-package-install": [
            "DrupalWxT\\WxT\\ScriptHandler::postCreateProject"
        ],
        "post-install-cmd": [
            "bash post_install.sh"
        ],
        "post-update-cmd": [
            "bash post_install.sh"
        ],
        "quick-start": [
            "composer install"
        ]
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "html/modules/contrib/webform/composer.libraries.json"
            ]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "html/"
            }
        },
        "installer-types": [
          "bower-asset",
          "npm-asset",
          "custom-module",
          "custom-theme"
        ],
        "installer-paths": {
            "html/core": [
                "type:drupal-core"
            ],
            "html/libraries/{$name}" : [
                "type:drupal-console-library",
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "html/modules/custom/{$name}": [
                "drupal/wxt_library",
                "type:drupal-custom-module"
            ],
            "html/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "html/profiles/{$name}": [
                "type:drupal-profile"
            ],
            "html/themes/custom/{$name}": [
                "drupal/wxt_bootstrap",
                "type:drupal-custom-theme"
            ],
            "html/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/contrib/{$name}": [
                "type:drupal-drush"
            ]
        },
        "composer-exit-on-patch-failure": true,
        "enable-patching": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/core": {
                "core views module fix for contextual filter":
                "https://www.drupal.org/files/issues/2628130-11.patch",
                "allow field groups to be compatible":
                "https://www.drupal.org/files/issues/2020-02-05/2546212-119.patch",
                "remove hreflang attribute from language switcher li element":
                "https://www.drupal.org/files/issues/2019-06-05/2454289-82.patch",
                "Language negotiation core fix, needed by access_unpublished and content moderation for forward draft revisions in non default language.":
                "https://www.drupal.org/files/issues/2019-05-30/drupal-2951294-21-fix-fallback.patch"
            },
            "drupal/access_unpublished": {
                "Adds a twig extension for access unpublished hash key link, patch 9.":
                "https://www.drupal.org/files/issues/2019-11-21/access_unpublished-3054536-9.patch",
                "Fix token-create while editing a French node":
                "https://www.drupal.org/files/issues/2019-03-20/access_unpublished-create_per_language_tokens-2958800-3.patch",
                "Edge case can result in null route - hasPendingRevision() validate for null.":
                "https://www.drupal.org/files/issues/2019-12-09/access_unpublished-TypeError_hasPendingRevision_null_fix-3099663-2.patch"
            },
            "drupal/entity_translation_unified_form": {
                "Support side-by-side interface and sync of moderation state with jquery":
                "https://www.drupal.org/files/issues/2020-05-12/etuf-sbs-3113998-13.patch"
            },
            "drupal/token": {
                "Add current language token.":
                "https://www.drupal.org/files/issues/2019-03-15/2863200-23.patch"
            },
            "drupal/moderated_content_bulk_publish": {
                "Custom functionality for workflows, bulk send to reviewer.":
                "https://www.drupal.org/files/issues/2020-06-02/3124868-12.patch"
            },
            "drupal/moderation_sidebar": {
                "Synchronize moderation states between all translations of the entity":
                "https://www.drupal.org/files/issues/2020-06-17/sync_all_translations_states-3143559-18.patch"
            },
            "drupal/wxt_bootstrap": {
                "Patch to allow custom blocks to be used without crashing on a null.":
                "https://www.drupal.org/files/issues/2020-04-27/3131393-2.patch",
                "wxt_bootstrap fix wcag article role is unnecessary.":
                "https://www.drupal.org/files/issues/2020-06-17/wxt_bootstrap-wcag_role_attribute_unnecessary_for_article-3152677-2.patch",
                "dropdown.js fix javascript error remove data-target attribute.":
                "https://www.drupal.org/files/issues/2020-06-17/wxt_bootstrap-backport_bootstrap_fix-3152560-2.patch",
                "Fix duplicate attribute on same element.":
                "https://www.drupal.org/files/issues/2020-06-17/wxt_bootstrap-wcag_fix_same_element_duplicate_attribute-3152669-2.patch"
            },
            "drupal/wxt_library": {
                "WCAG accessibility fix for search form on all wxt based projects.":
                "https://www.drupal.org/files/issues/2020-05-13/wxt_library_3136270-4.patch"
            }
        },
        "patches-ignore": {
            "acquia/lightning": {
                "drupal/core": {
                    "1356276 - Allow profiles to define a base/parent profile and load them in the correct order":
                    "https://www.drupal.org/files/issues/2019-11-05/1356276-531-8.8.x-4.patch",
                    "2914389 - Allow profiles to exclude dependencies of their parent":
                    "https://www.drupal.org/files/issues/2018-07-09/2914389-8-do-not-test.patch"
                }
            },
            "drupal/lightning_core": {
                "drupal/core": {
                    "1356276 - Allow profiles to define a base/parent profile and load them in the correct order":
                    "https://www.drupal.org/files/issues/2019-11-05/1356276-531-8.8.x-4.patch",
                    "2914389 - Allow profiles to exclude dependencies of their parent":
                    "https://www.drupal.org/files/issues/2018-07-09/2914389-8-do-not-test.patch"
                }
            }
        }
    },
    "require": {
        "composer/installers": "^1.2",
        "cweagans/composer-patches": "^1.6.7",
        "oomphinc/composer-installers-extender": "^1.1",
        "drupal/core-composer-scaffold": "*",
        "drush/drush": "^9.0",
        "drupalwxt/wxt": "3.0.11",
        "entreprise7pro/agri_admin": "*",
        "junhuang/idol_feed_api": "*",
        "entreprise7pro/config": "*",
        "entreprise7pro/grstheme_bootstrap": "*",
        "drupal/access_unpublished": "^1.0",
        "drupal/entity_translation_unified_form": "^1.0",
        "drupal/moderated_content_bulk_publish": "^1.0",
        "drupal/formblock": "1.x-dev",
        "drupal/warmer": "^1.1",
        "drupal/bigmenu": "^1.0",
        "drupal/purge": "^3.0@beta",
        "drupal/varnish_purger": "^1.12",
        "drupal/config_update": "^1.7",
        "drupal/config_split": "1.x-dev",
        "drupal/entityqueue": "1.0-beta5",
        "drupal/link_attributes": "^1.10",
        "drupal/memcache": "^2.0",
        "drupal/content_lock": "^2.0",
        "drupal/autologout": "^1.3",
        "drupal/views_published_or_roles": "^1.0",
        "drupal/sharedemail": "^2.1",
        "psr/container": "^1.0",
        "wikimedia/composer-merge-plugin": "^1.4",
        "scssphp/scssphp": "^1.1",
        "drupal/safedelete": "^1.0",
        "drupal/scanner": "1.x-dev"
    },
    "autoload": {
        "classmap": [
            "scripts/ScriptHandler.php"
        ]
    }
}
