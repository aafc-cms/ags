    "require": {
        "agrcmsx/dxbase": "9.4.7-rc5",
        "composer/installers": "^1.2",
        "cweagans/composer-patches": "^1.6.7",
        "cypresslab/gitelephant": "^4.4.3",
        "drupal/autologout": "1.3",
        "drupal/bootstrap": "3.25 as 3.23",
        "drupal/core": "9.4.7 as 9.3.16",
        "drupal/clientside_validation": "^3.0",
        "drupal/core-composer-scaffold": "^9",
        "drupal/dropzonejs": "2.7.0",
        "drupal/embed_block": "1.x-dev",
        "drupal/filebrowser": "^3.0",
        "drupal/file_replace": "^1.2",
        "drupal/link_attributes": "^1.10",
        "drupal/media_library_edit": "^2.1",
        "drupal/telephone_validation": "^2.3",
        "drupal/varnish_purger": "^2.1",
        "drupal/view_custom_table": "^2.0",
        "drupal/simple_sitemap": "4.1.2 as 3.11.0",
        "drupal/webform": "^6.1.3",
        "drupal/webform_translation_permissions": "^1.1",
        "entreprise7pro/agri_admin": "*",
        "entreprise7pro/agri_reports": "*",
        "entreprise7pro/config": "*",
        "entreprise7pro/grstheme_bootstrap": "*",
        "entreprise7pro/linkchecks": "*",
        "entreprise7pro/news_empl": "*",
        "entreprise7pro/news_bulletin": "*",
        "entreprise7pro/prefer_latest_content": "*",
        "entreprise7pro/wxt_overrides": "*",
        "junhuang/idol_feed_api": "*",
        "oomphinc/composer-installers-extender": "^1.1 || ^2",
        "drupal/views_bulk_operations": "^4.1",
        "drupal/ckeditor_codemirror": "2.4 as 2.3",
        "drupal/menu_block": "1.10.0 as 1.6.0",
        "drupal/paragraphs": "1.14.0 as 1.12.0",
        "drupal/pathauto": "1.11.0 as 1.8.0",
        "drupal/token_filter": "1.4.0 as 1.3.0",
        "drupal/views_bootstrap": "5.4.0 as 3.9.0",
        "drupal/context_stack": "^1.0",
        "drupal/webform_views": "^5.0@beta",
        "drupal/entity_translation_unified_form": "^2.0@RC",
        "wet-boew/wet-boew": "4.0.43.1 as 4.0.50.1",
        "drupal/siteimprove": "^1.12"
    },
    "autoload": {
        "classmap": [
            "scripts/ScriptHandler.php"
        ]
    }
}
