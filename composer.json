{
    "name": "drupalwxt/site-wxt",
    "description": "Project template for Drupal 9 sites built with the WxT distribution.",
    "type": "project",
    "license": "GPL-2.0+",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "behat/behat": "^3.0",
        "behat/mink": "~1.7",
        "behat/mink-extension": "*",
        "behat/mink-goutte-driver": "*",
        "behat/mink-selenium2-driver": "*",
        "oomphinc/composer-installers-extender": "^1.1 || ^2",
        "drupal/coder": "^8.3.7",
        "drupal/console": "^1.0",
        "pdepend/pdepend": "2.1.0",
        "phpmd/phpmd": "@stable",
        "jcalderonzumba/gastonjs": "~1.0.2",
        "jcalderonzumba/mink-phantomjs-driver": "~0.3.1",
        "mikey179/vfsstream": "~1.2",
        "sebastian/phpcpd": "*",
        "squizlabs/php_codesniffer": "^3.3"
    },
    "config": {
        "secure-http": false,
        "prestissimo": {
            "maxConnections": 10,
            "minConnections": 5
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        {
            "type": "composer",
            "url": "https://drupalwxt.github.io/composer-extdeps/"
        },
        {
            "type": "path",
            "url": "custom/modules/idol_feed_api"
        },
        {
            "type": "path",
            "url": "custom/modules/agri_admin"
        },
        {
            "type": "path",
            "url": "custom/modules/agri_reports"
        },
        {
            "type": "path",
            "url": "custom/modules/linkchecks"
        },
        {
            "type": "path",
            "url": "custom/modules/news_empl"
        },
        {
            "type": "path",
            "url": "custom/modules/news_bulletin"
        },
        {
            "type": "path",
            "url": "custom/modules/prefer_latest_content"
        },
        {
            "type": "path",
            "url": "custom/modules/wxt_overrides"
        },
        {
            "type": "path",
            "url": "custom/themes/grstheme_bootstrap"
        },
        {
            "type": "path",
            "url": "custom/config"
        }
    ],
    "scripts": {
        "post-root-package-install": [
            "DrupalWxT\\WxT\\ScriptHandler::postCreateProject"
        ],
        "pre-install-cmd": [
            "if [ -d html/sites/default ]; then chmod 775 html/sites/default; fi"
        ],
        "post-install-cmd": [
            "bash post_install.sh"
        ],
        "post-update-cmd": [
            "bash post_install.sh"
        ],
        "quick-start": [
            "composer install"
        ]
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "html/modules/contrib/webform/composer.libraries.json"
            ]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "html/"
            }
        },
        "installer-types": [
          "bower-asset",
          "npm-asset",
          "custom-module",
          "custom-theme"
        ],
        "installer-paths": {
            "html/core": [
                "type:drupal-core"
            ],
            "html/libraries/{$name}" : [
                "type:drupal-console-library",
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "html/modules/custom/{$name}": [
                "drupal/wxt_library",
                "type:drupal-custom-module"
            ],
            "html/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "html/profiles/{$name}": [
                "type:drupal-profile"
            ],
            "html/themes/custom/{$name}": [
                "drupal/wxt_bootstrap",
                "type:drupal-custom-theme"
            ],
            "html/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/contrib/{$name}": [
                "type:drupal-drush"
            ]
        },
        "composer-exit-on-patch-failure": true,
        "enable-patching": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/core": {
                "BigPipe when server under heavy load (linkchecks /linkchecker) results in PHP notices":
                "https://www.drupal.org/files/issues/2021-01-24/3194462.patch",
                "Performance and scalability, do not load disabled menu links on the add/node /edit/node page/route.":
                "https://www.drupal.org/files/issues/2021-04-21/D9_performance_and_scalability-3202930-6.patch",
                "file usage bug fixes":
                "https://www.drupal.org/files/issues/2020-04-03/2810355-64.patch",
                "core views module fix for breadcrumb title and page title":
                "https://www.drupal.org/files/issues/2020-10-14/D9.1-views_titles_in_breadcrumb_and_metatag-2716019-115.patch",
                "9.x GOOD: Improve wysiwyg entity embed media dialog add label to media hyperlinked to media":
                "https://www.drupal.org/files/issues/2020-11-11/D9-add_label_and_link_to_EditorMediaDialog-3182027-6.patch",
                "safedelete entity_translation_unified_form form set error squelch noise about #parent element":
                "https://www.drupal.org/files/issues/2019-08-31/3027240-12.patch",
                "w3c valid self closing source and track tags":
                "https://www.drupal.org/files/issues/2020-07-13/D89x-self_closing_correct-2857273-13.patch",
                "remove hreflang attribute from language switcher li element":
                "https://www.drupal.org/files/issues/2020-12-14/D9-2454289-101.patch",
                "Node preview current language":
                "https://www.drupal.org/files/issues/2020-06-20/node-preview_current_language-3150728-12.patch",
                "Language negotiation core fix, needed by access_unpublished and content moderation for forward draft revisions in non default language.":
                "https://www.drupal.org/files/issues/2021-06-29/drupal-fix_fallback-2951294-39.patch",
                "Options module uses '_none' as a special value.":
                "https://www.drupal.org/files/issues/2021-06-03/1585930-72.patch"
            },
            "drupal/pathauto": {
                "Duplicate alias entities created with Create a new alias. Leave the existing alias functioning setting":
                "https://www.drupal.org/files/issues/2020-01-17/pathauto-3107144-2.patch"
            },
            "drupal/access_unpublished": {
                "Adds a twig extension for access unpublished hash key link, patch 12.": "https://www.drupal.org/files/issues/2021-05-21/v1.1-access_unpublished-3054536-12.patch",
                "Fix token-create while editing a French node": "https://www.drupal.org/files/issues/2019-03-20/access_unpublished-create_per_language_tokens-2958800-3.patch",
                "Edge case can result in null route - hasPendingRevision() validate for null.": "https://www.drupal.org/files/issues/2019-12-09/access_unpublished-TypeError_hasPendingRevision_null_fix-3099663-2.patch",
                "Invalid text representation: 7 ERROR when deleting a comment field from a node bundle - issue no. 3214261": "https://www.drupal.org/files/issues/2021-05-16/access_unpublished-prevent_error_when_deleting_a_comment_field_from_a_bundle-3214261-2.patch"
            },
            "drupal/bootstrap": {
                "views submit button name attribute cannot be empty for w3c":
                "https://www.drupal.org/files/issues/2020-07-10/3061891-27.patch",
                "fix array_unique warnings on node/49 page":
                "https://www.drupal.org/files/issues/2020-09-29/bootstrap-3173776-3.patch"
            },
            "drupal/better_exposed_filters": {
                "Drupal 9 compatibility for date picker.":
                "https://www.drupal.org/files/issues/2021-09-03/3182069-date_range_date_picker_autocomplete.patch"
            },
            "drupal/core": {
                "Enter drupal/core patch #2559833 description here": "https://www.drupal.org/files/issues/2021-06-02/comment_form_redirect-2559833-87.patch",
                "Enter drupal/core patch #2922570 description here": "https://www.drupal.org/files/issues/2021-09-08/2922570-90.9.2.5.patch"
            },
            "drupal/entity_embed": {
                "entity_embed-remove_image_attributes_from_div-3086162":
                "https://www.drupal.org/files/issues/2020-06-15/entity_embed-remove_image_attributes_from_div-3086162-13_0.patch"
            },
            "drupal/entity_translation_unified_form": {
                "3239503 - Always try to sync moderation state even when sbs not enabled, make this opt-out option":
                "https://www.drupal.org/files/issues/2021-09-27/etuf-3239503-5.patch",
		"Moderation Status section is not aligned with other fields in Claro theme":
                "https://www.drupal.org/files/issues/2021-10-05/clarotheme-3240865-02.patch"
            },
            "drupal/field_group": {
                "3111107 - Use patch 10 instead of patch 2.":
                "https://www.drupal.org/files/issues/2021-08-10/field_group_fix-translations_label_description_2021-08-10.patch"
            },
            "drupal/file_delete": {
                "Add functionality to immediately delete files and override usage check":
                "https://www.drupal.org/files/issues/2020-10-20/3115158-6.patch"
            },
            "drupal/linkchecker": {
                "Extraction status":
                "https://www.drupal.org/files/issues/2020-12-08/3184613-extraction-status.patch",
                "Update empty value for last_check field on broken links report":
                "https://www.drupal.org/files/issues/2020-12-25/3112537-12.patch",
                "Allow linkchecker to work in a non-standard environment, provide host and port substitution.": "https://www.drupal.org/files/issues/2021-05-14/3213210_13.patch"
            },
            "drupal/linkit": {
                "Detect and strip base URL from pasted URLs to increase matching hits":
                "https://www.drupal.org/files/issues/2021-02-02/3078075-26.patch"
            },
            "drupal/moderation_sidebar": {
                "3194841 - Override patch 3 with patch 7 instead.":
                "https://www.drupal.org/files/issues/2021-02-22/3194841-discard-draft-7.patch",
                "Synchronize moderation states between all translations of the entity":
                "https://www.drupal.org/files/issues/2020-06-17/sync_all_translations_states-3143559-18.patch"
            },
            "drupal/token": {
                "Token module patch issue 2906445.":
                 "https://www.drupal.org/files/issues/2020-01-04/2906445-token-entity-reference-returns-default-language-5.patch"
            },
            "drupal/scanner": {
                "Allow creator role to use the search and replace functionality.":
                "https://www.drupal.org/files/issues/2020-06-22/scanner-grant_without_administer_nodes-3153873-2.patch"
            },
            "drupal/views_data_export": {
                "Allow altering row data for csv export, adds a hook called hook_views_data_export_row_alter":
                "https://www.drupal.org/files/issues/2020-08-18/views-data-export-row-hook-3015117-7.patch",
                "Save to predictable folder":
                "https://www.drupal.org/files/issues/2021-01-08/1875456-82.patch"
            },
            "drupal/page_manager": {
                "Enter drupal/page_manager patch #2752227 description here":
                "https://www.drupal.org/files/issues/2018-07-05/page_manager-incorrect-page_title-2752227-32-8.x.4.x.patch",
                "Enter drupal/page_manager patch #3096408 description here":
                "https://www.drupal.org/files/issues/2019-11-23/Issue-3096408-Page-Manager-issue-with-conflict-modul.patch"
            },
            "drupal/filebrowser": {
                "Warning filesize:stat failed/filetype:Lstat failed/filectime:stat failed for a symlink":
                "https://www.drupal.org/files/issues/2021-10-22/filesize-statfailed-3245404-02.patch"
            }
        },
        "patches-ignore": {
            "acquia/lightning": {
                "drupal/core": {
                    "1356276 - Allow profiles to define a base/parent profile and load them in the correct order":
                    "https://www.drupal.org/files/issues/2019-11-05/1356276-531-8.8.x-4.patch",
                    "2914389 - Allow profiles to exclude dependencies of their parent":
                    "https://www.drupal.org/files/issues/2018-07-09/2914389-8-do-not-test.patch"
                }
            },
            "drupalwxt/wxt": {
                "drupal/core": {
                    "Enter drupal/core patch #2559833 description here": "https://www.drupal.org/files/issues/2020-10-31/2559833-72.patch",
                    "Enter drupal/core patch #2998826 description here": "https://www.drupal.org/files/issues/2021-03-17/core-Term_route_context-2998826-93.patch",
                    "Enter drupal/core patch #2470896 description here": "https://www.drupal.org/files/issues/2021-06-10/2470896-244.patch",
                    "Enter drupal/core patch #2922570 description here": "https://www.drupal.org/files/issues/2021-06-29/D91x-2922570-88.patch"
                },
                "drupal/ctools": {
                    "is in dev patch":
                    "https://www.drupal.org/files/issues/entityview-cache-metadata-2874176-2.patch"
                },
                "drupal/field_group": {
                    "3111107 - Remove patch , no longer works, override it with patch 10.":
                    "https://www.drupal.org/files/issues/2020-02-04/3111107-2--fix-translations.patch"
                },
                "drupal/moderation_sidebar": {
                    "3194841 - Override patch 3 with patch 7 instead.":
                    "https://www.drupal.org/files/issues/2021-02-12/3194841-3.patch"
                },
                "drupal/page_manager": {
                    "3151905 ignore smulvih changes":
                    "https://www.drupal.org/files/issues/2018-07-05/page_manager-incorrect-page_title-2752227-32-8.x.4.x.patch"
                },
                "drupal/panels": {
                    "patch desc 2900531":
                    "https://www.drupal.org/files/issues/classes_should_be_array-2900531-2.patch"
                }
            },
            "drupal/lightning_core": {
                "drupal/core": {
                    "1356276 - Allow profiles to define a base/parent profile and load them in the correct order":
                    "https://www.drupal.org/files/issues/2020-03-24/1356276-531-9.0.x-9.patch",
                    "2914389 - Allow profiles to exclude dependencies of their parent":
                    "https://www.drupal.org/files/issues/2018-07-09/2914389-8-do-not-test.patch",
                    "overrides for profile and sub profile use 633 instead of 631":
                    "https://www.drupal.org/files/issues/2020-12-11/1356276-631-by-mpotter-balsama-phenaproxima.patch",
                    "1356276 - Allow profiles to define a base/parent profile and load them in the correct order":
                    "https://www.drupal.org/files/issues/2019-11-05/1356276-531-8.8.x-4.patch",
                    "2914389 - Allow profiles to exclude dependencies of their parent":
                    "https://www.drupal.org/files/issues/2018-07-09/2914389-8-do-not-test.patch"
                }
            }
        }
    },
    "require": {
        "agrcmsx/prefer_latest_content": "*",
        "composer/installers": "^1.2",
        "cweagans/composer-patches": "^1.6.7",
        "cypresslab/gitelephant": "^4.2",
        "drupalwxt/wxt": "^4.1.1",
        "drupal/clientside_validation": "^3.0",
        "drupal/core-composer-scaffold": "^9",
        "drupal/core": "9.2.7 as 9.1.13",
        "drupal/access_unpublished": "^1.0",
        "drupal/autologout": "^1.3",
        "drupal/better_exposed_filters": "^5.0@beta",
        "drupal/bigmenu": "^2.0",
        "drupal/conditional_fields": "^1.0",
        "drupal/config_ignore": "2.x-dev@dev",
        "drupal/config_split": "^1.6",
        "drupal/config_update": "^1.7",
        "drupal/content_lock": "^2.0",
        "drupal/content_moderation_notifications": "3.x-dev",
        "drupal/convert_bundles": "^1.0",
        "drupal/devel_kint_extras": "^1.0",
        "drupal/devel": "^4.0",
        "drupal/entity_translation_unified_form": "1.0-beta20",
        "drupal/entityqueue": "^1.0",
        "drupal/filebrowser": "^3.0",
        "drupal/file_delete": "^1.0",
        "drupal/file_replace": "^1.2",
        "drupal/filehash": "^1.4",
        "drupal/formblock": "^2.0.0-beta2",
        "drupal/form_options_attributes": "^2.0",
        "drupal/git_status": "^1.0",
        "drupal/honeypot": "^2.0.1",
        "drupal/jquery_ui_datepicker": "^1.0",
        "drupal/jsonapi_explorer": "^1.0",
        "drupal/libraries": "^3.0@beta",
        "drupal/link_attributes": "^1.10",
        "drupal/linkchecker": "^1.0@alpha",
        "drupal/memcache": "^2.0",
        "drupal/menu_admin_per_menu": "^1.3",
        "drupal/moderated_content_bulk_publish": "^2.0",
        "drupal/purge": "3.0",
        "drupal/recreate_block_content": "2.x-dev",
        "drupal/safedelete": "^1.0.19",
        "drupal/scanner": "1.x-dev",
        "drupal/sharedemail": "^2.1",
        "drupal/smtp": "1.x-dev",
        "drupal/swiftmailer": "^2.0",
        "drupal/telephone_validation": "^2.3",
        "drupal/token": "~1.0",
        "drupal/varnish_purger": "^2.1",
        "drupal/view_custom_table": "^1.6",
        "drupal/views_data_export": "^1.0",
        "drupal/views_published_or_roles": "^1.0",
        "drupal/warmer": "^1.1",
        "drupal/w3c_validator": "^1.4",
        "drupal/ultimate_cron": "^2.0@alpha",
        "drush/drush": "^10.0",
        "entreprise7pro/agri_admin": "*",
        "entreprise7pro/agri_reports": "*",
        "entreprise7pro/config": "*",
        "entreprise7pro/grstheme_bootstrap": "*",
        "entreprise7pro/linkchecks": "*",
        "entreprise7pro/news_empl": "*",
        "entreprise7pro/news_bulletin": "*",
        "entreprise7pro/wxt_overrides": "*",
        "junhuang/idol_feed_api": "*",
        "oomphinc/composer-installers-extender": "^1.1 || ^2",
        "psr/container": "^1.0",
        "scssphp/scssphp": "^1.1"
    },
    "autoload": {
        "classmap": [
            "scripts/ScriptHandler.php"
        ]
    }
}
