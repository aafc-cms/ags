{
    "name": "agrcms/proto",
    "description": "WxT based intranet sub project.",
    "type": "project",
    "license": "GPL-2.0+",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "package",
            "package": {
                "name": "agrcms/behatags",
                "version": "1.0.4",
                "type": "agrcms-library",
                "source": {
                    "url": "https://gitlab.com/agrcms/behatags.git",
                    "type": "git",
                    "reference": "master"
                }
            }
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        {
            "type": "composer",
            "url": "https://drupalwxt.github.io/composer-extdeps/"
        },
        {
            "type": "path",
            "url": "custom/modules/idol_feed_api"
        },
        {
            "type": "path",
            "url": "custom/modules/agri_admin"
        },
        {
            "type": "path",
            "url": "custom/modules/agri_reports"
        },
        {
            "type": "path",
            "url": "custom/modules/linkchecks"
        },
        {
            "type": "path",
            "url": "custom/modules/news_empl"
        },
        {
            "type": "path",
            "url": "custom/modules/news_bulletin"
        },
        {
            "type": "path",
            "url": "custom/modules/prefer_latest_content"
        },
        {
            "type": "path",
            "url": "custom/modules/wxt_overrides"
        },
        {
            "type": "path",
            "url": "custom/themes/grstheme_bootstrap"
        },
        {
            "type": "path",
            "url": "custom/config"
        }
    ],
    "scripts": {
        "post-root-package-install": [
            "DrupalWxT\\WxT\\ScriptHandler::postCreateProject"
        ],
        "pre-install-cmd": [
            "if [ -d html/sites/default ]; then chmod 775 html/sites/default; fi; rm tests/behatags/.gitignore -f;"
        ],
        "pre-update-cmd": [
            "rm tests/behatags/.gitignore -f;"
        ],
        "post-install-cmd": [
            "rm tests/behatags/.gitignore -f;bash post_install.sh"
        ],
        "post-update-cmd": [
            "bash post_install.sh"
        ],
        "quick-start": [
            "composer install"
        ]
    },
    "require-dev": {
        "agrcms/behatags": "^1.0.0",
        "behat/behat": "v3.10.0",
        "behat/mink": "~1.7",
        "behat/mink-extension": "2.3.1",
	"behat/mink-browserkit-driver": "v1.4.1",
        "behat/mink-goutte-driver": "v1.3.0",
        "behat/mink-selenium2-driver": "v1.5.0",
        "oomphinc/composer-installers-extender": "^1.1 || ^2",
        "drupal/coder": "^8.3.7",
        "pdepend/pdepend": "2.1.0",
        "phpmd/phpmd": "@stable",
        "jcalderonzumba/gastonjs": "~1.0.2",
        "jcalderonzumba/mink-phantomjs-driver": "~0.3.1",
        "mikey179/vfsstream": "~1.2",
        "sebastian/phpcpd": "*",
        "squizlabs/php_codesniffer": "^3.3"
    },
    "config": {
        "secure-http": false,
        "prestissimo": {
            "maxConnections": 10,
            "minConnections": 5
        },
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "oomphinc/composer-installers-extender": true,
            "drupal/console-extend-plugin": true,
            "drupal/core-composer-scaffold": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "html/modules/contrib/webform/composer.libraries.json"
            ]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "html/"
            }
        },
        "installer-types": [
          "bower-asset",
          "npm-asset",
          "custom-module",
          "agrcms-library",
          "custom-theme"
        ],
        "installer-paths": {
            "html/core": [
                "type:drupal-core"
            ],
            "html/libraries/{$name}" : [
                "type:drupal-console-library",
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "html/modules/custom/{$name}": [
                "drupal/wxt_library",
                "type:drupal-custom-module"
            ],
            "html/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "tests/{$name}": [
               "type:agrcms-library"
            ],
            "html/profiles/{$name}": [
                "type:drupal-profile"
            ],
            "html/themes/custom/{$name}": [
                "drupal/wxt_bootstrap",
                "type:drupal-custom-theme"
            ],
            "html/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/contrib/{$name}": [
                "type:drupal-drush"
            ]
        },
        "composer-exit-on-patch-failure": true,
        "enable-patching": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/core": {
                "Options module uses '_none' as a special value.":
                "https://www.drupal.org/files/issues/2021-10-13/1585930-79.patch",
                "Call to a member function getThirdPartySetting() on null in ContentTranslationManager":
                "https://www.drupal.org/files/issues/2022-11-30/2868294-87.patch"
            },
            "drupal/field_group": {
                "3111107 - Use patch 10 instead of patch 2.":
                "https://www.drupal.org/files/issues/2021-08-10/field_group_fix-translations_label_description_2021-08-10.patch"
            },
            "drupal/page_manager": {
                "Enter drupal/page_manager patch #2752227 description here":
                "https://www.drupal.org/files/issues/2018-07-05/page_manager-incorrect-page_title-2752227-32-8.x.4.x.patch",
                "Enter drupal/page_manager patch #3096408 description here":
                "https://www.drupal.org/files/issues/2019-11-23/Issue-3096408-Page-Manager-issue-with-conflict-modul.patch"
            },
            "drupal/embed_block": {
                "3225938 - Added CKEDITOR plugin functionality":
                "https://www.drupal.org/files/issues/2022-02-05/3225938_include_binary_icon-18.patch",
                "3225938 - Custom":
                "https://www.drupal.org/files/issues/2021-12-15/3225938-custom_only_diff-10.patch"
            },
            "drupal/filebrowser": {
                "Warning filesize:stat failed/filetype:Lstat failed/filectime:stat failed for a symlink":
                "https://www.drupal.org/files/issues/2021-10-22/filesize-statfailed-3245404-02.patch"
            },
            "drupal/entity_translation_unified_form": {
                "3283608 - The client requires an extra Save only button which allows the URL to stay at the /node/nodeID/edit page":
                "https://www.drupal.org/files/issues/2022-06-20/save-only-3283608-18.patch"
            },
            "drupal/safedelete": {
                "3320470 - Make the bulk publish verification configurable to allow the user to perform the bulk publish action on the pages in a particular user case.": "https://www.drupal.org/files/issues/2022-11-24/make-bulk-publish-verification-configurable-3320470-04.patch"
            },
            "drupal/wxt_library": {
                "3293413 - PHP 8.1 compatibility fix. Cannot pass null parameter.": "https://www.drupal.org/files/issues/2022-06-29/wxt_library-php81_compat-3293413-04.patch"
            }
        },
        "patches-ignore": {
            "acquia/lightning": {
                "drupal/core": {
                    "1356276 - Allow profiles to define a base/parent profile and load them in the correct order":
                    "https://www.drupal.org/files/issues/2019-11-05/1356276-531-8.8.x-4.patch",
                    "2914389 - Allow profiles to exclude dependencies of their parent":
                    "https://www.drupal.org/files/issues/2018-07-09/2914389-8-do-not-test.patch"
                }
            },
            "agrcmsx/dxbase": {
                "drupal/bootstrap": {
                  "3173776 - patch included with bootstrap 3.2.5/3.2.4, only needed if using 3.2.3": "https://www.drupal.org/files/issues/2020-09-29/bootstrap-3173776-3.patch"
                }
            },
            "drupalwxt/wxt": {
                "drupal/core": {
                    "850600 - Postgresql patch we're not using postgresql": "https://www.drupal.org/files/issues/postgresql_ssl_dsn-850600-3.patch",
                    "2893407 - POST /quickedit/metadata returning HTTP 503 - patch 47.":
                    "https://www.drupal.org/files/issues/2021-06-07/2893407-47.patch",
                    "1356276 - Overrides for profile and sub profile use 686 instead of 631-by-mpotter-balsa": "https://www.drupal.org/files/issues/2021-10-21/1356276-673.patch",
                    "1356276 - Profile sub profiles phenaproxima 9.2.x": "https://www.drupal.org/files/issues/2021-06-29/D91x-1356276-656.patch",
                    "1356276 - Profile sub profiles phenaproxima 675 9.3.x": "https://www.drupal.org/files/issues/2021-11-18/1356276-675.patch",
                    "2559833 - Comment form": "https://www.drupal.org/files/issues/2020-10-31/2559833-72.patch",
                    "2630732 - Migrate module we don't use currently": "https://www.drupal.org/files/issues/2020-09-17/2630732-77.patch",
                    "2907413 - Rerolled patch for 9.3.x is in the patches section.": "https://www.drupal.org/files/issues/2019-06-21/2907413-11.patch",
                    "2907413 - Rerolled patch for 9.4.x is in the patches section.": "https://www.drupal.org/files/issues/2021-11-19/D93x-2907413-23.patch",
                    "2921627 - Rerolled patch for 9.3.x is in the patches section.": "https://www.drupal.org/files/issues/2021-10-13/2921627-71.patch",
                    "3164210 - Fixed in 9.4.x.": "https://www.drupal.org/files/issues/2021-05-17/3164210-11.patch",
                    "3184667 - Fixed in 9.4.x.": "https://www.drupal.org/files/issues/2021-08-20/3184667-38.patch",
                    "3236799 - Fixed in 9.4.x.": "https://www.drupal.org/files/issues/2021-12-22/drupal-core-9.2.x-li-role-separator-tag-linkGenerator-3236799-11.patch",
                    "2632132 - Removed/deprecated in 9.4.x": "https://www.drupal.org/files/issues/2019-10-11/Move_Seven_block_config_into_the_Seven_theme-2632132-42.patch",
                    "3107212 - Removed/deprecated in 9.4.x": "https://www.drupal.org/files/issues/2022-03-09/d9-3-x--3107212-13.patch",
                    "2907413 - Rerolled patch for 9.3.x was in patches section": "https://www.drupal.org/files/issues/2021-11-19/D93x-2907413-23.patch",
                    "2907413 - Rerolled patch for 9.4.x is in the patches section.": "https://www.drupal.org/files/issues/2022-07-20/2907413-28.patch",
                    "Enter drupal/core patch #2559833 description here": "https://www.drupal.org/files/issues/2020-10-31/2559833-72.patch",
                    "Enter drupal/core patch #2630732 description here": "https://www.drupal.org/files/issues/2020-09-17/2630732-77.patch",
                    "Enter drupal/core patch #2907413 description here": "https://www.drupal.org/files/issues/2019-06-21/2907413-11.patch",
                    "Enter drupal/core patch #2998826 description here": "https://www.drupal.org/files/issues/2021-03-17/core-Term_route_context-2998826-93.patch",
                    "Enter drupal/core patch #2470896 description here": "https://www.drupal.org/files/issues/2021-06-10/2470896-244.patch",
                    "2907413 - Rerolled patch for 9.3.x is in the patches section.": "https://www.drupal.org/files/issues/2019-06-21/2907413-11.patch",
                    "3150294 - Rerolled patch for 9.4.x is in the patches section.": "https://www.drupal.org/files/issues/2021-11-02/3150294-74.patch",
                    "3150294 - Rerolled patch for 9.4.x is in the patches section.": "https://www.drupal.org/files/issues/2022-01-05/3150294-95.patch",
                    "2922570 - See reroll in 2922570-88 (above).":
                    "https://www.drupal.org/files/issues/2021-02-02/2922570-61.patch",
                    "2893407 - POST /quickedit/metadata returning HTTP 503 - patch 39.":
                    "https://www.drupal.org/files/issues/2020-01-09/2893407-39.patch",
                    "1356276 - Overrides for profile and sub profile use 633 instead of 631-by-mpotter-balsa":
                    "https://www.drupal.org/files/issues/2020-12-13/1356276-633-by-mpotter-balsama-phenaproxima-9.1.0-9.2.x.patch",
                    "1356276 - Overrides for profile and sub profile use 686 instead of 656": "https://www.drupal.org/files/issues/2021-06-29/D91x-1356276-656.patch"
                },
                "drupal/bootstrap": {
                    "3209773 - patch included with bootstrap 3.2.5/3.2.4, only needed if using 3.2.3": "https://www.drupal.org/files/issues/2021-08-24/bootstrap-toggle_undefined-3209773-8.patch"
                },
                "drupal/ctools": {
                    "is in dev patch":
                    "https://www.drupal.org/files/issues/entityview-cache-metadata-2874176-2.patch"
                },
                "drupal/pathauto": {
                    "3184164 - Is only in latest releases.":
                    "https://www.drupal.org/files/issues/2020-11-23/3184164-2.patch"
                },
                "drupal/field_group": {
                    "3111107 - Remove patch , no longer works, override it with patch 10.":
                    "https://www.drupal.org/files/issues/2020-02-04/3111107-2--fix-translations.patch"
                },
                "drupal/moderation_sidebar": {
                    "3194841 - Override patch 3 with patch 7 instead.":
                    "https://www.drupal.org/files/issues/2021-02-12/3194841-3.patch"
                },
                "drupal/page_manager": {
                    "3151905 ignore smulvih changes":
                    "https://www.drupal.org/files/issues/2018-07-05/page_manager-incorrect-page_title-2752227-32-8.x.4.x.patch"
                },
                "drupal/panels": {
                    "patch desc 2900531":
                    "https://www.drupal.org/files/issues/classes_should_be_array-2900531-2.patch"
                }
            },
            "drupal/lightning_core": {
                "drupal/core": {
                    "1356276 - Allow profiles to define a base/parent profile and load them in the correct order":
                    "https://www.drupal.org/files/issues/2020-03-24/1356276-531-9.0.x-9.patch",
                    "2914389 - Allow profiles to exclude dependencies of their parent":
                    "https://www.drupal.org/files/issues/2018-07-09/2914389-8-do-not-test.patch",
                    "overrides for profile and sub profile use 633 instead of 631":
                    "https://www.drupal.org/files/issues/2020-12-11/1356276-631-by-mpotter-balsama-phenaproxima.patch",
                    "1356276 - Allow profiles to define a base/parent profile and load them in the correct order":
                    "https://www.drupal.org/files/issues/2019-11-05/1356276-531-8.8.x-4.patch",
                    "2914389 - Allow profiles to exclude dependencies of their parent":
                    "https://www.drupal.org/files/issues/2018-07-09/2914389-8-do-not-test.patch"
