<?php

/**
 * @file
 * Primary module hooks for News-Empl module.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\agri_admin\Utils;

/**
 * Implements hook_preprocess_html().
 */
function news_empl_page_attachments(array &$page) {
  // Add page meta.
  $route_match = Utils::getRouteName();
  if ($route_match == 'entity.node.canonical') {
    $node = \Drupal::routeMatch()->getParameter('node');
    $anonymous = \Drupal::currentUser()->isAnonymous();
    if ($node->bundle() == 'empl') {
      // For IE11 support.
      $page['#attached']['library'][] = 'jquery_ui_datepicker/datepicker';
    }
    elseif ($node->bundle() == 'news') {
      // Not yet needed.
      $page['#attached']['library'][] = 'news_empl/news-node-css';
      // For IE11 support.
      $page['#attached']['library'][] = 'jquery_ui_datepicker/datepicker';
    }
    if ($anonymous && \Drupal::service('path.matcher')->isFrontPage()) {
      // This actually only affects the front page.
      $page['#attached']['library'][] = 'news_empl/anonymous-empl-node-css';
      $page['#attached']['library'][] = 'news_empl/anonymous-news-node-css';
    }
  }
  if ($route_match == 'view.view_employmentopportunities.page_1') {
    $page['#attached']['library'][] = 'news_empl/empl-opp';
    // \Drupal\agri_admin\AgriAdminHelper::addToLog($route_match, TRUE);
  }
}

/**
 * Implements hook_form_node_news_form_alter().
 */
function news_empl_form_node_news_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $route_match = Utils::getRouteName();
  if ($route_match == 'entity.node.canonical') {
    // Enhance form css.
    $form['#attached']['library'][] = 'news_empl/news-form';
  }
}

/**
 * Implements hook_form_node_empl_form_alter().
 */
function news_empl_form_node_empl_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $route_match = Utils::getRouteName();
  if ($route_match == 'entity.node.canonical') {
    // Enhance form css.
    $form['#attached']['library'][] = 'news_empl/empl-form';
  }
}
