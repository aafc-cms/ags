<?php

/**
 * @file
 * Runtime hooks for agrisource_search_processors.
 */

declare(strict_types=1);

use Drupal\block_content\Entity\BlockContent;
use Drupal\Core\Url;
use Drupal\views\ViewExecutable;


/**
 * Implements hook_views_pre_render().
 *
 * Add a JS flag so the client knows whether there are results.
 */
function agrisource_search_processors_views_pre_render(ViewExecutable $view) : void {
  if ($view->id() !== 'search') {
    return;
  }

  $has_results = !empty($view->result);
  $view->element['#attached']['drupalSettings']['agrisourceSearch']['hasResults'] = $has_results;
  $view->element['#attached']['library'][] = 'agrisource_search_processors/search_hash';
}

/**
 * Implements hook_page_attachments_alter().
 *
 * Attach library on the page manager route as well, in case the View is embedded.
 */
function agrisource_search_processors_page_attachments_alter(array &$attachments) {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name === 'page_manager.page_view_search_search-panels_variant-0') {
    $attachments['#attached']['library'][] = 'agrisource_search_processors/search_hash';
  }
}

/**
 * Implements hook_block_view_alter().
 *
 * Adjust language switcher URLs so they use the correct fragment.
 */
function agrisource_search_processors_block_view_alter(array &$build, \Drupal\Core\Block\BlockPluginInterface $block) {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name !== 'page_manager.page_view_search_search-panels_variant-0') {
    return;
  }
  if ($block->getPluginId() !== 'language_block:language_interface') {
    return;
  }

  // Determine current language and whether the search has results.
  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $has_results = !empty(\Drupal::request()->attributes->get('_drupal_settings')['agrisourceSearch']['hasResults'])
    || !empty(\Drupal::request()->query->all()['query']); // fallback heuristic.

  $fragment = $has_results ? ($langcode === 'fr' ? '#resultats' : '#results') : '#edit-query';

  foreach (\Drupal::service('language_manager')->getLanguages() as $target_langcode => $lang) {
    if (isset($build['#links'][$target_langcode])) {
      $url = $build['#links'][$target_langcode]['url'];
      $url = $url->setOption('fragment', ltrim($fragment, '#'));
      $build['#links'][$target_langcode]['url'] = $url;
    }
  }
}

/**
 * Cron implementation: ensure block body matches expected markup.
 */
function agrisource_search_processors_cron(): void {
  agrisource_search_processors_update_block_bodies();
}

/**
 * Status page hook: run the same check/update each time the report is viewed.
 *
 * This both reports status and (only if needed) updates the block body content.
 */
function agrisource_search_processors_requirements(string $phase): array {
  $requirements = [];

  if ($phase === 'runtime') {
    [$changed, $messages] = agrisource_search_processors_update_block_bodies();

    $requirements['agrisource_search_processors.block_15_body_sync'] = [
      'title' => t('Agrisource search block (ID 15) body sync'),
      'value' => $changed ? t('Updated') : t('Already up to date'),
      'severity' => $changed ? REQUIREMENT_WARNING : REQUIREMENT_OK,
      'description' => $messages ? implode(' ', $messages) : t('Checked English and French translations.'),
    ];
  }

  return $requirements;
}

/**
 * Core worker that checks/updates the Block Content #15 body in EN/FR.
 *
 * - Loads block_content entity ID 15 (bundle "basic").
 * - Computes language-aware <front> path for EN and FR.
 * - Builds expected markup:
 *   EN: <form class="form-inline" action="<front>/search" id="q" method="get" role="search"></form>
 *   FR: <form class="form-inline" action="<front>/recherche" id="q" method="get" role="search"></form>
 * - If the current body != expected, update it, preserving the field format.
 *
 * @return array{0: bool, 1: string[]}
 *   Tuple: [whether any change was made, messages describing actions].
 */
function agrisource_search_processors_update_block_bodies(): array {
  $changed = FALSE;
  $messages = [];

  /** @var \Drupal\block_content\BlockContentInterface|null $block */
  $block = BlockContent::load(15);
  if (!$block) {
    $messages[] = t('Block Content entity with ID 15 was not found.');
    return [$changed, $messages];
  }

  $language_manager = \Drupal::languageManager();
  $en = $language_manager->getLanguage('en');
  $fr = $language_manager->getLanguage('fr');

  // Helper to compute the language-aware <front> path without scheme/host.
  $front_for_lang = static function ($langcode) use ($language_manager): string {
    $lang = $language_manager->getLanguage($langcode);
    if (!$lang) {
      return '/';
    }
    // Generate a relative URL for <front> in the target language.
    $front = Url::fromRoute('<front>', [], [
      'language' => $lang,
      'absolute' => FALSE,
    ])->toString();

    // Normalize to path only, no trailing slash (except root).
    $front = rtrim($front, '/');
    return $front === '' ? '/' : $front;
  };

  // Build expected markup per language.
  $expected = [];
  if ($en) {
    $en_front = $front_for_lang('en'); // e.g., '/', '/en'
    $en_front_trimmed = rtrim($en_front, '/');
    // Ensure exactly one slash between <front> and the action path.
    $expected['en'] = <<<EOF
<section class="visible-md visible-lg" id="wb-srch">
  <h2 class="wb-inv">
    Find a colleague
  </h2>
  <form class="form-inline col-xs-12 col-sm-6" action="http://directinfo.agr.gc.ca/directInfo/eng/index.php" method="get" name="qsForm" target="_self" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
    <div class="form-group">
      <label class="control-label sr-only" for="Agrisource-qsBox">Search</label>
        <input name="qsType" type="hidden" value="qsEmp">&nbsp;
        <input class="form-control" id="Agrisource-qsBox" name="qsBox" placeholder="Find a colleague in Directinfo" type="text" value="" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
        <input name="fuseaction" type="hidden" value="agriInfo.qSearchResults">
    </div>
    <div class="submit form-group js-form-wrapper form-wrapper" data-drupal-selector="edit-submit-directinfo" id="edit-submit-directinfo">
      <button class="btn btn-primary btn-small" name="qsBtn" type="submit">
        <span class="glyphicon glyphicon-search" aria-hidden="true"></span>
        <span class="wb-inv">Search</span>
      </button>
    </div>
  </form>
  <h2>
    Search
  </h2>
  <form class="form-inline" action="{$en_front_trimmed}/search#results" id="agrisource-search" method="get" role="search">
    <div class="form-group">
      <label class="wb-inv" for="q">Search AgriSource</label>&nbsp;<input placeholder="Search AgriSource" class="form-control" id="q" maxlength="150" name="query" size="20" type="search" value=""> <input id="sort_order" name="sort_order" type="hidden" value="DESC">
    </div>
    <div class="submit form-group js-form-wrapper form-wrapper" data-drupal-selector="edit-submit-container" id="edit-submit-container">
      <button class="btn-primary button js-form-submit form-submit btn icon-before" data-drupal-selector="wb-srch-sub" type="submit" id="wb-srch-sub" name="op" value="" title="Search">
        <span class="icon glyphicon glyphicon-search" aria-hidden="true"></span>
          <span class="wb-inv">Search</span>
        </button>
      </div>
  </form>
</section>
EOF;
  }
  if ($fr) {
    $fr_front = $front_for_lang('fr'); // e.g., '/', '/fr'
    $fr_front_trimmed = rtrim($fr_front, '/');
    $expected['fr'] = <<<EOF
<section class="visible-md visible-lg" id="wb-srch">
  <h2 class="wb-inv">
    Trouver un collègue
  </h2>
  <form class="form-inline col-xs-12 col-sm-6" action="http://directinfo.agr.gc.ca/directInfo/fra/index.php" method="get" name="qsForm" target="_self" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
    <div class="form-group">
      <label class="control-label sr-only" for="Agrisource-qsBox">Rechercher</label>
        <input name="qsType" type="hidden" value="qsEmp">&nbsp;
        <input class="form-control" id="Agrisource-qsBox" name="qsBox" placeholder="Trouver un collègue dans Directinfo" type="search" value="" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
        <input name="fuseaction" type="hidden" value="agriInfo.qSearchResults">
    </div>
    <div class="submit form-group js-form-wrapper form-wrapper" data-drupal-selector="edit-submit-directinfo" id="edit-submit-directinfo">
      <button class="btn btn-primary btn-small" name="qsBtn" type="submit">
        <span class="glyphicon glyphicon-search" aria-hidden="true"></span>
        <span class="wb-inv">Rechercher</span>
      </button>
    </div>
  </form>
  <h2>
    Recherche
  </h2>
  <form class="form-inline" action="{$fr_front_trimmed}/search#resultats" id="agrisource-search" method="get" role="search">
    <div class="form-group">
      <label class="wb-inv" for="q">Recherche sur AgriSource</label>&nbsp;<input placeholder="Recherche sur AgriSource" class="form-control" id="q" maxlength="150" name="query" size="20" type="search" value=""> <input id="sort_order" name="sort_order" type="hidden" value="DESC">
    </div>
    <div class="submit form-group js-form-wrapper form-wrapper" data-drupal-selector="edit-submit-container" id="edit-submit-container">
      <button class="btn-primary button js-form-submit form-submit btn icon-before" data-drupal-selector="wb-srch-sub" type="submit" id="wb-srch-sub" name="op" value="" title="Recherche">
        <span class="icon glyphicon glyphicon-search" aria-hidden="true"></span>
        <span class="wb-inv">Recherche</span>
      </button>
      </div>
  </form>
</section>
EOF;
  }

  // Update per available translation.
  foreach (['en', 'fr'] as $langcode) {
    if (!isset($expected[$langcode])) {
      $messages[] = t('Language @lang not configured; skipping.', ['@lang' => $langcode]);
      continue;
    }

    if (!$block->hasTranslation($langcode)) {
      $messages[] = t('Block 15 has no @lang translation; skipping.', ['@lang' => $langcode]);
      continue;
    }

    $trans = $block->getTranslation($langcode);
    $field = $trans->get('body');

    $current = '';
    $format = 'full_html';
    if (!$field->isEmpty()) {
      /** @var array{value:string, format:string}|null $item */
      $item = $field->first()?->toArray();
      if ($item) {
        $current = (string) ($item['value'] ?? '');
        $format = (string) ($item['format'] ?? $format);
      }
    }

    $want = $expected[$langcode];
    // Strict string compare after a basic trim.
    if (trim($current) !== trim($want)) {
      $trans->set('body', [
        'value' => $want,
        'format' => $format,
      ]);
      $messages[] = t('Updated block 15 body for @lang.', ['@lang' => $langcode]);
      $changed = TRUE;
    }
    else {
      $messages[] = t('No change needed for @lang; already matches.', ['@lang' => $langcode]);
    }
  }

  if ($changed) {
    // Save once for all translation updates.
    $block->save();
    \Drupal::logger('agrisource_search_processors')->notice('Block 15 body updated for one or more languages.');
  }

  return [$changed, $messages];
}

