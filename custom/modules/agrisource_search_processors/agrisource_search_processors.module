<?php

/**
 * @file
 * Primary module hooks for Agrisource Search Processors module.
 */

use Drupal\search_api\IndexInterface;

/**
 * Final cleanup before items go to the backend.
 *
 * Implements: hook_search_api_index_items_alter(IndexInterface $index, array &$items).
 */
function agrisource_search_processors_search_api_index_items_alter(IndexInterface $index, array &$items) {
  // Replace with your index machine name.
  if ($index->id() !== 'content') {
    return;
  }

  foreach ($items as $id => $item) {
    // While testing, you can narrow to a single item:
    // if ($id !== 'entity:node/3275:en') { continue; }

    // 1) Log field IDs once so we see what’s actually available on this item.
    $field_ids = array_keys($item->getFields());
    \Drupal::logger('agrisource_search_processors')->notice('[final-strip] item @id has fields: @f', [
      '@id' => $id,
      '@f'  => implode(', ', $field_ids),
    ]);

    // 2) Targeted fields first (if present on this item / your index):
    $targets = ['body', 'rendered_item', 'search_api_fulltext']; // add/trim as needed
    foreach ($targets as $fid) {
      $field = $item->getField($fid);
      if (!$field) {
        continue;
      }
      $vals = $field->getValues();
      $changed = FALSE;

      foreach ($vals as $i => $v) {
        if ($v instanceof \Drupal\Component\Render\MarkupInterface) {
          $v = (string) $v;
        }
        if (!is_string($v) || $v === '') {
          continue;
        }
        $orig = $v;
        // Strip <style>/<script> blocks.
        $v = preg_replace('#<style\b[^>]*>.*?</style>#is', ' ', $v);
        $v = preg_replace('#<script\b[^>]*>.*?</script>#is', ' ', $v);
        // Normalize whitespace.
        $v = trim(preg_replace('/\s+/u', ' ', $v));

        if ($v !== $orig) {
          $vals[$i] = $v;
          $changed = TRUE;
        }
      }

      if ($changed) {
        $field->setValues($vals);
        \Drupal::logger('agrisource_search_processors')->notice('[final-strip] cleaned @fid on @id', [
          '@fid' => $fid,
          '@id'  => $id,
        ]);
      }
    }

    // 3) Safety net: also clean *all* text/string fields.
    foreach ($item->getFields() as $fid => $field) {
      $type = $field->getType();
      if ($type !== 'text' && $type !== 'string') {
        continue;
      }
      $vals = $field->getValues();
      if (!$vals) {
        continue;
      }
      $changed = FALSE;

      foreach ($vals as $i => $v) {
        if ($v instanceof \Drupal\Component\Render\MarkupInterface) {
          $v = (string) $v;
        }
        if (!is_string($v) || $v === '') {
          continue;
        }
        $orig = $v;
        $v = preg_replace('#<style\b[^>]*>.*?</style>#is', ' ', $v);
        $v = preg_replace('#<script\b[^>]*>.*?</script>#is', ' ', $v);
        $v = trim(preg_replace('/\s+/u', ' ', $v));
        if ($v !== $orig) {
          $vals[$i] = $v;
          $changed = TRUE;
        }
      }

      if ($changed) {
        $field->setValues($vals);
        \Drupal::logger('agrisource_search_processors')->notice('[final-strip] cleaned (generic) @fid on @id', [
          '@fid' => $fid,
          '@id'  => $id,
        ]);
      }
    }
  }
}

/**
 * Implements hook_module_implements_alter().
 */
function agrisource_search_processors_module_implements_alter(&$implementations, $hook) {
  if ($hook === 'search_api_index_items_alter') {
    // Move agrisource_search_processors to the end.
    $module = 'agrisource_search_processors';
    if (isset($implementations[$module])) {
      $weight = $implementations[$module];
      unset($implementations[$module]);
      $implementations[$module] = $weight;
    }
  }
}
