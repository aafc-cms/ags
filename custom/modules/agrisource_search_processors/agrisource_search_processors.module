<?php

/**
 * @file
 * Primary module hooks for Agrisource Search Processors module.
 */

use Drupal\Component\Render\MarkupInterface;
use Drupal\search_api\IndexInterface;

/**
 * Final cleanup before items go to the backend.
 *
 * Implements: hook_search_api_index_items_alter(IndexInterface $index, array &$items).
 */
/**
 * Implements hook_search_api_index_items_alter().
 */
function agrisource_search_processors_search_api_index_items_alter(IndexInterface $index, array &$items) {
  // Limit to your index machine name.
  if ($index->id() !== 'content') {
    return;
  }

  foreach ($items as $id => $item) {
    // (Optional) one-time: see the field IDs available on this item.
    // \Drupal::logger('agrisource_search_processors')->notice('[final-strip] @id fields: @f', [
    //   '@id' => $id,
    //   '@f'  => implode(', ', array_keys($item->getFields())),
    // ]);

    foreach ($item->getFields() as $fid => $field) {
      $values  = $field->getValues();
      if (!$values) {
        continue;
      }

      $changed = FALSE;
      foreach ($values as $i => $v) {
        if ($id === 'entity:node/3275:en') {
          \Drupal::logger('agrisource_search_TEST')->notice('[debug-strip] @fid on @id', [
            '@fid' => $fid,
            '@id'  => $id,
          ]);
        }
        if ($v instanceof MarkupInterface) {
          $v = (string) $v;
        }
        if (!is_string($v) || $v === '') {
          continue;
        }

        $orig = $v;

        // Remove entire <style>...</style> and <script>...</script> blocks.
        $v = preg_replace('#<style\b[^>]*>.*?</style>#is', ' ', $v);
        $v = preg_replace('#<script\b[^>]*>.*?</script>#is', ' ', $v);

        // Heuristic: also remove naked CSS rule blocks (belt + suspenders).
        $v = preg_replace('/(?:^|\s)[.#@]?[a-zA-Z0-9_-][^{]{0,400}\{[^}]{0,2000}\}/m', ' ', $v);

        // Normalize whitespace.
        $v = trim(preg_replace('/\s+/u', ' ', $v));

        // (Optional) sentinel so you can spot the change in Solr for 3275.
        if ($id === 'entity:node/3275:en' && !str_starts_with($v, '[STRIPPED✔]')) {
          $v = '[STRIPPED✔] ' . $v;
          \Drupal::logger('agrisource_search_HIT')->notice('[final-strip] cleaned @fid on @id', [
            '@fid' => $fid,
            '@id'  => $id,
          ]);
        }

        if ($v !== $orig) {
          $values[$i] = $v;
          $changed = TRUE;
        }
      }

      if ($changed) {
        $field->setValues($values);
        \Drupal::logger('agrisource_search_processors')->notice('[final-strip] cleaned @fid on @id', [
          '@fid' => $fid,
          '@id'  => $id,
        ]);
      }
    }
  }
}
