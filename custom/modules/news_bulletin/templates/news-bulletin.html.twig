{{ attach_library('news_bulletin/bulletins') }}

<br>
<br>
<pre>{#{ dump(types_by_weight) }#}</pre>
<br><br><br>
<pre>{#{ dump(news_items) }#}</pre>
<br>
<br>

<form action="/en/news-bulletin-email" method="post" id="news-bulletin-form-1" accept-charset="UTF-8">
{% set nth_run = 0 %}
{% set n_idx = 0 %}
<table class="table table-news-bulletin">
{% for wkey, valuetype in types_by_weight %}
  {% if valuetype.has_items %}
    {% set open_close = 'open' %}
  {% else %}
    {% set open_close = 'close' %}
  {% endif %}
  <thead class="type-{{ valuetype.first_word }}" data-attribute-group="{{ valuetype.tid }}">
    <tr>
      <th class="glyphicon glyphicon-folder-{{ open_close }} tb-news-group-title">{{ valuetype.name }}</th>
    {% if nth_run == 1 %}
      <th></th>
      <th></th>
      <th></th>
      <th></th>
    {% else %}
    <th></th>
    <th>Title</th>
    <th>from</th>
    <th>Summary</th>
    {% endif %}
    </tr>
  </thead>
  {% set nth_run = 1 %}
  {% if open_close == 'close' %}
  <tbody class="tile-tbody"></tbody>
  {% endif %}
  {% if open_close == 'open' %}
    <tbody class="tile-tbody">
    {% for nkey, newsitem in news_items %}
    {% if valuetype.tid == newsitem.term_id %}
    <tr class="value-row type-{{ newsitem.first_word }}" data-nid="{{ newsitem.nid }}" data-group-current="{{ newsitem.term_id }}" data-group-orig="{{ newsitem.term_id }}">
      <td class="glyphicon glyphicon-move news-bulletin-move bulletin td-spacer"></td>
      <td>
        <input data-selector="select-node-{{ n_idx }}" checked="checked" type="checkbox" id="edit-select-node-{{ n_idx }}" name="edit_select_node_form[{{ n_idx }}]" value="0" class="form-checkbox form-boolean form-boolean--type-checkbox">
         <label class="sr-only" for="edit_select_node_form[{{ n_idx }}]">If checked will include "{{ newsitem.title }}" in email template.</label>
      </td>
      <td class="bulletin td-news-title">{{ newsitem.title }}</td>
      <td class="bulletin td-from">{{ newsitem.from }}</td>
      <td class="bulletin td-summary">{{ newsitem.summary }}</td>
    </tr>
    </tbody>
    {% set n_idx = n_idx + 1 %}
    {% endif %}
    {% endfor %}
  {% endif %}
{% endfor %}
</table>
</form>


<!-- micro-template for bulletin rows -->
<script type="text/template" id="bulletin-row">
  <div id="th_ROW_NUM_" class="row bs-row">
    <div class="thumb-tbl">
      <div class="thumb-row row-eq-height">
      </div>
    </div>
  </div>
</script>

<!-- micro-template for bulletin cards -->
<script type="text/template" id="bulletin-card">
  <div class="bulletin-card" data-bulletin="_DATA_BULLETIN_" data-index="_DATA_INDEX_" data-title="_DATA_TITLE_">
      <div class="bulletin-thumb">
        <img class="img-responsive" src="_IMG_SRC_" alt="_TITLEBULLETIN_" />
        <div class="thumb-text-wrapper">
          <div class="title">_TITLE_</div>
	</div>
        <div class="description">_DESC_</div>
    </div>
  </div>
</script>

<!-- micro-template for bulletin cards in single-column format -->
<script type="text/template" id="bulletin-card-single">
  <div class="bulletin-card" data-bulletin="_DATA_BULLETIN_" data-index="_DATA_INDEX_" data-title="_DATA_TITLE_">
    <div class="bulletin-thumb">
        <div class="td col-xs-12">
          <div class="title">_TITLE_</div>
          <div class="field_from">_FROM_</div>
          <div class="description">_DESC_</div>
          <div class="scrubber"></div>
        </div>
    </div>
  </div>
</script>
