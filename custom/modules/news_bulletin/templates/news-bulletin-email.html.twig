{{ attach_library('news_bulletin/email-bulletins') }}
<a name="English"></a>
<div id="list" class="news-bulletin">
</div>
  <table class="headerrow1">
    <tbody>
    <tr>
      <td>
        <font>EN | <a href="#French">FR</a>
        </font>
      </td>
    </tr>
    </tbody>
    </table>
  <table class="headerrow2">
  <tbody>
    <tr>
      <td><img src="http://www.agr.gc.ca/resources/prev/CMS/Internet/News-Nouvelles/computer_sm.png">
        <br>
        <font><i>news@work | nouvelles@l'ouvrage</i>
        </font>
        <br>
        <font>WEEKLY NEWSLETTER / BULLETIN HEBDOMADAIRE
        <br>
        </font>
      </td>
      </tr>
    </tbody>
  </table>
<br>

<div id="news-bulletin-list" class="news-bulletin-test col-xs-12">
{% for wkey, valuetype in types_by_weight %}
  <div class="news-type type-{{ valuetype.first_word }} news-type-id-{{ valuetype.tid }} col-xs-12" data-attribute-group="{{ valuetype.tid }}">
    <div class="news-group-title">{{ valuetype.name }}</div>
  </div>
  {% for nkey, newsitem in news_items %}
    {% if valuetype.tid == newsitem.term_id %}
    <div class="tile news-type-id-{{ valuetype.tid }}  col-xs-11 col-md-offset-1">
      <div class="content type-{{ newsitem.first_word }}" data-nid="{{ newsitem.nid }}" data-group-current="{{ newsitem.term_id }}" data-group-orig="{{ newsitem.term_id }}">
        <div class="cell news-title"><a href="{{ newsitem.href }}">{{ newsitem.title }}</a></div>
        <div class="cell from">{{ newsitem.from }}</div>
        <div class="cell image">{% autoescape false %} {{ newsitem.image|raw }} {% endautoescape %}</div>
        <div class="cell summary">{{ newsitem.summary }}</div>
      </div>
      <div class="splitter"></div>
    </div>
    {% endif %}
  {% endfor %}
{% endfor %}
  <!--<div class="row pagination">
    <a class="hidden bulletin-pager" href="#">
      {% trans %}
        Show More
      {% endtrans %}
    </a>
  </div>-->
</div>


<table class="newsreleasesstatement">
  <tr><td><h3>AAFC News Releases and Statements</h3>
  </td></tr>
</table>
<table class="newsreleasesstatementdetails">
  <tbody>
    <tr>
    <td>
      <img class="flexibleImagesmall" src="http://www.agr.gc.ca/resources/prod/news/images/news_icon_sm.png" alt="AAFC News Releases and Statements">
    </td>
    <td>
      <div>Check out AAFC's latest <a href="http://www.agr.gc.ca/eng/news/news-releases-and-statements/?id=1383076728778">news releases and statements.</a>
      </div>
    </td>
    </tr>
  </tbody>
</table>

<table class="emplopp">
  <tr><td><h3>Employment Opportunities</h3>
  <br>Visit the Internal Employment Opportunities page to find any available acting, assignment and deployment opportunities within AAFC.
  </td></tr>
</table>
<table class="emploppdetails">
  <tbody>
    <tr>
    <td>
      <a href="/en/internal-employment-opportunities" target="_blank">View Opportunities</a>
    </td>
    </tr>
  </tbody>
</table>

<div class="footer">
<table>
  <tbody>
    <tr>
      <td class="content-block">
        <span class="apple-link">
        <!--<a href="#">Printer Version</a> | -->
            <a href="/en/news/newswork">news@work main page</a>
             |
            <a href="https://collab.agr.gc.ca/br-dg/ccb-dgcc/Lists/bulletins/AllItems.aspx">news@work Bulletins</a>
             |
            <a href="/en/news/newswork/submit-article-news-work">Submit a news@work item</a>
             |
            <a href="mailto:newsatwork@agr.gc.ca">Contact Us</a>
          </span>
          <br>
          <br>
           Please check AgriSource daily. Additional news@work articles are posted regularly. For technical difficulties accessing or viewing news@work, please contact the IT Centre (1-855-545-4411 ;
          <a href="mailto:service@itcentreti.collaboration.gc.ca">service@itcentreti.collaboration.gc.ca</a>
           ).
        </td>
      </tr>
      <tr>
        <td class="content-block powered-by"> </td>
      </tr>
  </tbody>
</table>
</div>
