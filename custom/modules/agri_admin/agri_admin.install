/**
 * Change node__field_created_by from string 25 to string 100.
 */
function agri_admin_update_8004() {
  $database = \Drupal::database();
  $table = 'node__field_created_by';
  $entity_type = 'node';
  $field_name = 'field_created_by';

  $field_storage = FieldStorageConfig::loadByName($entity_type, $field_name);

  if (is_null($field_storage)) {
    return;
  }

  $rows = NULL;

  if ($database->schema()->tableExists($table)) {
    // The table data to restore after the update is completed.
    $rows = $database->select($table, 'n')
      ->fields('n')
      ->execute()
      ->fetchAll();
  }

  $new_fields = array();

  // Use existing field config for new field.
  foreach ($field_storage->getBundles() as $bundle => $label) {
    $field = FieldConfig::loadByName($entity_type, $bundle, $field_name);
    $new_field = $field->toArray();
    $new_field['field_type'] = 'string';
    $new_field['settings'] = array();

    $new_fields[] = $new_field;
  }

  // Deleting field storage which will also delete bundles(fields).
  $new_field_storage = $field_storage->toArray();
  $new_field_storage['type'] = 'string';
  $new_field_storage['settings'] = array(
    'max_length' => 100,
    'is_ascii' => FALSE,
    'case_sensitive' => FALSE,
  );

  $field_storage->delete();

  // Purge field data now to allow new field and field_storage with same name
  // to be created. You may need to increase batch size.
  field_purge_batch(10);

  // Create new field storage.
  $new_field_storage = FieldStorageConfig::create($new_field_storage);
  $new_field_storage->save();

  // Create new fields.
  foreach ($new_fields as $new_field) {
    $new_field = FieldConfig::create($new_field);
    $new_field->save();
  }

  // Restore existing data in the same table.
  if (!is_null($rows)) {
    foreach ($rows as $row) {
      $database->insert($table)
        ->fields((array) $row)
        ->execute();
    }
  }

}


/**
 * Delete the duplicate url aliases for the node
 */
function agri_admin_update_8005() {

  $query = \Drupal::entityQuery('node');
  $group = $query->orConditionGroup()
    ->accessCheck(FALSE)
    ->condition('type', 'page', '=')
    ->condition('type', 'landing_page', '=')
    ->condition('type', 'empl', '=')
    ->condition('type', 'news', '=');
  $query->condition($group)
    ->accessCheck(FALSE);
  $nids = $query->accessCheck(FALSE)
    ->execute();

  $path_alias_storage = \Drupal::entityTypeManager()->getStorage('path_alias');
  foreach ($nids as $nid) {
    // langcode = en & langcode = fr
    $actual_alias_e = \Drupal::service('path_alias.manager')
      ->getAliasByPath('/node/' . $nid, 'en');
    $actual_alias_f = \Drupal::service('path_alias.manager')
      ->getAliasByPath('/node/' . $nid, 'fr');

    // Load all path alias for this node.
    $alias_objects_e = $path_alias_storage->loadByProperties([
      'path' => '/node/' . $nid, 'langcode' => 'en',
    ]);
    if (count($alias_objects_e) > 1) {
      //keep the latest revision
      array_pop($alias_objects_e);
      foreach ($alias_objects_e as $alias_object_e) {
        // delete duplicate record only
        if ($alias_object_e->get('alias')->value == $actual_alias_e) {
          $alias_object_e->delete();
        }
      }
    }

    // langcode = French
    // Load all path alias for this node.
    $alias_objects_f = $path_alias_storage->loadByProperties([
      'path' => '/node/' . $nid, 'langcode' => 'fr',
    ]);
    if (count($alias_objects_f) > 1) {
      //keep the latest revision
      array_pop($alias_objects_f);
      foreach ($alias_objects_f as $alias_object_f) {
        // delete duplicate record only
        if ($alias_object_f->get('alias')->value == $actual_alias_f) {
          $alias_object_f->delete();
        }
      }
    }
  }
}



/**
 * Update CS to IT.
 */
function agri_admin_update_8006() {

  $connection = \Drupal\Core\Database\Database::getConnection();
  $lang = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $lang = 'en';
  $num_updated = $connection->update('paragraph_revision__field_class_id')
    ->fields(['field_class_id_value' => 'IT'])
    ->condition('field_class_id_value', 'CS', '=')
    ->execute();
  // Executed the statement part a.

  $type = 'warning';
  $message = 'Part a) There were no CS records to update.';
  if ($num_updated) {
    $type = 'notice';
    $message = "agri_admin_update_8006() part A) updated $num_updated employment entity revisions from CS to IT.";
  }
  \Drupal::logger('agri_admin')->notice($message);
  \Drupal::messenger()->addMessage($message, $type, TRUE);

  $num_updated = $connection->update('paragraph__field_class_id')
    ->fields(['field_class_id_value' => 'IT'])
    ->condition('field_class_id_value', 'CS', '=')
    ->execute();
  // Executed the statement part b.

  $message = 'Part b) There were no CS records to update.';
  if ($num_updated) {
    $type = 'notice';
    $message = "agri_admin_update_8006() part B) updated $num_updated employment entity records from CS to IT.";
  }
  \Drupal::messenger()->addMessage($message, $type, TRUE);
  \Drupal::logger('agri_admin')->notice($message);

}

/**
 * Clean up mismatched entity and or field definitions.
 */
function agri_admin_update_8007() {
  $module = 'meaofd';
  $moduleHandler = \Drupal::service('module_handler');
  $moduleInstaller = \Drupal::service('module_installer');

  // Rebuild cache to ensure module discovery.
  drupal_flush_all_caches();

  // Ensure the module exists before attempting to install it.
  $modulePath = \Drupal::service('extension.list.module')->getPath($module);
  if (!$modulePath) {
    \Drupal::logger('agri_admin')->error("The module {$module} is missing. Ensure it is installed in modules/contrib or modules/custom.");
    return;
  }

  // Check if the module is installed.
  if (!$moduleHandler->moduleExists($module)) {
    // Install the module.
    $moduleInstaller->install([$module]);
  }

  // Ensure the module is installed before calling the service.
  if ($moduleHandler->moduleExists($module)) {
    $fixer = \Drupal::service('meaofd.fixer');
    $fixer->fix('node');
    $fixer->fix('block_content');
    $fixer->fix('user');
  }
}

/**
 * Disable specific footer menu links by menu_link_content ID (mlid).
 */
function agri_admin_update_8008(): void {
  $ids = [6, 8, 17, 19, 30, 35, 42, 47];

  foreach ($ids as $id) {
    /** @var \Drupal\menu_link_content\Entity\MenuLinkContent|null $link */
    $link = MenuLinkContent::load($id);

    if (!$link) {
      // Link not found on this site; keep the update idempotent.
      continue;
    }

    if (!$link->isEnabled()) {
      // Already disabled; idempotent.
      continue;
    }

    $link->set('enabled', 0);
    $link->save();
  }
}

/**
 * Add a hidden "Footer" <nolink> item to the footer menu.
 */
function agri_admin_update_8009(): void {
  // 1) Important notices -> /node/27 (with FR translation "Avis importants").
  // Use internal: URI to avoid hardcoding scheme/host.
  $notices_existing = \Drupal::entityQuery('menu_link_content')
    ->condition('menu_name', 'footer')
    ->condition('title', 'Important notices')
    ->condition('link.uri', 'internal:/node/27')
    ->accessCheck(FALSE)
    ->execute();

  if (empty($notices_existing)) {
    $notices_link = MenuLinkContent::create([
      'title' => 'Important notices',
      'menu_name' => 'footer',
      'link' => ['uri' => 'internal:/node/27'],
      'enabled' => 1,
      'expanded' => 0,
      // Put it above the heavy "Footer" item; adjust as you like.
      'weight' => 0,
    ]);

    // Add a French translation for the title.
    // This assumes your site has 'fr' enabled.
    if ($notices_link->hasTranslation('fr')) {
      $fr = $notices_link->getTranslation('fr');
      $fr->set('title', 'Avis importants');
    }
    else {
      $notices_link->addTranslation('fr', ['title' => 'Avis importants']);
    }

    $notices_link->save();
  }
  // 2) Contact us -> /node/28 (with FR translation "Contactez-nous").
