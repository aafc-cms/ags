/**
 * Implements hook_preprocess_views_view_field().
 *
 *   For replacing current revision field values with latest pending revision field values.
 * This is so we can have themed (orange as example) pending draft rows. To complement the
 * hotpink current draft rows.
 *
 * @todo add {{ status }} to a view row (must be yes / no custom boolean not Yes / No , use lowercase in the view field custom.
 * May 14 2020: Added the implementation for customization on
 * Oct 16 2020: Added content view to be supported.
 */
function agri_admin_preprocess_views_view_field(&$variables) {
  $lang = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $view = $variables['view'];

  $hasPermission = FALSE;
  if ($variables['logged_in']) {
    $user = \Drupal::currentUser();
    $hasPermission = $user->hasPermission('agrisource pending drafts');
  }
  $lang = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $otherLang = 'fr';
  if ($lang == 'fr') {
    $otherLang = 'en';
  }

  $view = $variables['view'];
  if ($hasPermission &&
       ($view->id() == 'news' ||
        $view->id() == 'newsatwork_for_home_page' ||
        $view->id() == 'content' ||
  // Added for Moderated Content view related code block below.
        $view->id() == 'moderated_content' ||
        $view->id() == 'moderation_dashboard_content_locked' ||
        $view->id() == 'view_employmentopportunities' ||
        $view->id() == 'view_news_work')) {
    $field = $variables['field'];
    $row = $variables['row'];
    $nid = $row->_entity->id();
    $vid = $row->_entity->getLoadedRevisionId();

    // This IF block only for Moderated Content view.
    // Returning after this block ends since the rest of the code currently does not apply to this view.
    if (($view->id() == 'moderated_content') || ($view->id() == 'moderation_dashboard_content_locked')) {
      if ($field->field == 'moderation_state') {
        $moderationState = $row->_entity->get('moderation_state')->getString();
        if ($moderationState == 'draft') {
          $node = \Drupal::entityTypeManager()->getStorage('node')->load($nid);
          if ($node->isPublished()) {
            if ($view->id() == 'moderated_content') {
              $variables['output'] = t('pending draft');
            }
            elseif ($view->id() == 'moderation_dashboard_content_locked') {
              $variables['output'] = t('Pending draft');
            }
          }
        }
      }
      return;
    }

    if ($row->_entity->isPublished() && $latestRevision = AgriAdminHelper::getLatestRevisionOnlyIfDraft($nid, $vid)) {
      if ($field->field == 'status') {
        // This is specifically for the row styling (view -> Format -> settings -> row {{ status }}.
        // title
        // body
        // field_fieldname
        // status
        // nid
        // field_title.
        $variables['output'] = strtolower($variables['output']);
        $variables['output'] = Markup::create(str_replace('yes', 'no pending-draft', $variables['output']));
      }
      elseif ($field->field == 'operations') {
        return;
      }
      elseif ($field->field == 'moderation_state_1') {
        // This is specifically for the row styling (view -> Format -> settings -> row {{ moderation_state_1 }}.
        // Do nothing, for styling purposes, because archived should have another color see css/scss.
        return;
      }
      elseif ($view->id() == 'content' && $field->field == 'moderation_state') {
        $variables['output'] = $variables['output'] . ' + ' . t('pending draft');
        return;
      }
      elseif ($view->id() == 'content' && $field->field == 'name') {
        // This field needs special treatment.
        // @todo Lakshman will probably notice this, will have to replace content author with revision author.
        $user = $latestRevision->getRevisionUser();  // removing the linking because the Author column is currently unlinked in admin/content view.
//        $render_array = ['#markup' => "<a href=\"/" . $lang . "/user/" . $user->id() . "\">" . $user->getAccountName() . "</a>"];
        $variables['output'] = $user->getAccountName();  //Utils::render($render_array);
        return;
      }
      elseif ($field->field == 'node_bulk_form') {
        // There is no fieldable field called 'node_bulk_form' this is a vbo field, so skip it.
        return;
      }
      elseif ($field->field == 'nothing') {
        // There is no fieldable field called 'nothing' this is a views field, so skip it.
        return;
      }
      elseif ($field->field == 'machine_name') {
        // There is no fieldable field called 'machine_name', so skip it.
        return;
      }
      elseif ($field->field == 'edit_node') {
        // There is no fieldable field called 'edit_node', so skip it.
        return;
      }
      elseif ($field->field == 'delete_node') {
        // There is no fieldable field called 'delete_node', so skip it.
        return;
      }
      elseif ($field->field == 'nid') {
        // There is no fieldable field called 'nid', so skip it.
        return;
      }
      elseif ($field->field == 'tid') {
        // There is no fieldable field called 'tid', so skip it.
        return;
      }
      else {
        $valueCurrent = '';
        if ($lang == 'fr') {
          $valueCurrent = $row->_entity->getTranslation($lang)->get($field->field)->value;
        }
        else {
          $valueCurrent = $row->_entity->get($field->field)->value;
        }
        // Already in current language.
        $valuePending = $latestRevision->get($field->field)->value;
        // Replace characters in the field output.
	if (!isset($valuePending)) {
          $valuePending = '';
	}       
        if (!isset($valueCurrent)) {
          // PHP 8.1 compatibility, prevent null str_replace.
          $valueCurrent = '';
        }
        $variables['output'] = Markup::create(str_replace($valueCurrent, $valuePending, $variables['output']));
        if ($view->id() != 'content' && ($field->field == 'title' || $field->field == 'field_title')) {
          $alias = \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $nid);
          $urlPathToLatest = '/node/' . $nid . '/latest';
          // Replace path to node in the field output.
          $variables['output'] = Markup::create(str_replace($alias, $urlPathToLatest, $variables['output']));
        }
        elseif ($view->id() == 'content' && ($field->field == 'title' || $field->field == 'field_title')) {
          $alias = \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $nid);
          $urlPathToLatest = "/$lang/node/$nid/latest";
          // Replace path to node in the field output.
          $variables['output'] = Markup::create($variables['output'] . ' <a href="' . $urlPathToLatest . '"><b>( ' . t('Pending Draft') . ' )</b></a>');
        }
      }
    }
  }

  if ($view->id() == 'moderated_content' || $view->id() == 'content') {
    $field = $variables['field'];
    if ($field->field == 'nid' || $field->field == 'id') {
      $row = $variables['row'];
      $nid = $row->_entity->id();
      // Retrieves a \Drupal\Core\Database\Connection which is a PDO instance.
      // NORMALLY DO NOT USE THIS, use \Drupal::database() instead.
      // Only doing this here because of dcr_id for altered table (not a Drupal column).
      $connection = Database::getConnection();
      $dcr_id_column_exists = $connection->schema()->fieldExists('node', 'dcr_id');
      if (!$dcr_id_column_exists) {
        return;
      }
      // Retrieves a PDOStatement object
      // http://php.net/manual/en/pdo.prepare.php
      $sth = $connection->select('node', 'n')
        ->fields('n', ['dcr_id'])
        ->condition('n.nid', $variables['output'], '=');

      // Execute the statement.
      $data = $sth->execute();

      // Get only one result.
      $result = $data->fetch();
      $value = $result->dcr_id;
      if (property_exists($result, 'dcr_id') && isset($result->dcr_id)) {
        $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
        if ($langcode == 'en') {
          $variables['output'] = Markup::create("<span class='nid'>" . $variables['output'] . "</span><span class='legacy-dcr-id'>$value</span>" .
          '<span class="fa fa-clipboard" style="margin-left: 10px" title="Copy dcr_id"></span>');
        }
        else {
          $variables['output'] = Markup::create("<span class='nid'>" . $variables['output'] . "</span><span class='legacy-dcr-id'>$value</span>" .
          '<span class="fa fa-clipboard" style="margin-left: 10px" title="Copier le dcr_id"></span>');
        }
      }
    }
  }

  if ($view->id() == 'view_employmentopportunities') {
    $field = $variables['field'];
    $row = $variables['row'];
    $node = $row->_entity;
    if ($node->hasTranslation($lang)) {
      // Safely get translation.
      // fix French Translation issues.
      $translatednode = $node->getTranslation($lang);
    }
    else {
      // Failsafe default.
      $translatednode = $node;
    }
    $classification = '';
    if ($field->field == 'field_classification' && $node->getType() == 'empl') {
      // If ($row->_entity->get($field->field)->value) {.
      if ($paragraph_field_items = $translatednode->get('field_classification')->getValue()) {
        $paragraph_storage = \Drupal::entityTypeManager()->getStorage('paragraph');
        // Collect paragraph field's ids.
        $ids = array_column($paragraph_field_items, 'target_id');
        // Load all paragraph objects.
        $paragraphs_objects = $paragraph_storage->loadMultiple($ids);
        foreach ($paragraphs_objects as $paragraph) {
          // Get field from the paragraph.
          $groupval    = $paragraph->get('field_class_id')->value;
          $subgroupval = $paragraph->get('field_class_sub')->value;
          $levelval    = $paragraph->get('field_class_level')->value;
          $tmpText     = '';
          // Do something with $text...
          if ($subgroupval) {
            $tmpText = $groupval . '-' . $subgroupval . '-' . $levelval;
          }
          else {
            $tmpText = $groupval . '-' . $levelval;
          }
          if (strlen($classification) > 0) {
            $classification = $classification . ', ' . $tmpText;
          }
          else {
            $classification = $tmpText;
          }
        }
        $ptitle = $translatednode->get('title')->value;
        // Friendly url explained: https://drupal.stackexchange.com/a/275438/99288 .
        // Relative url.
        $friendly_url = $translatednode->toUrl()->toString();
        // $friendly_url = $node->toUrl()->setAbsolute()->toString(); // Or absolute url.
        // @Note to James, previously, $nid was undefined, so this was producing an invalid link.
        // So I changed it to the friendly url instead as a fix and improvement.
        $titlefield = '<a href="' . $friendly_url . '"' . ' hreflang="' . $lang . '">' . $ptitle . '</a>';
        $variables['output'] = Markup::create($classification . ' ' . $titlefield);
      }
    }

  }
}

/**
 * Implements hook_ENTITY_TYPE_insert().
 */
function agri_admin_node_insert(EntityInterface $entity) {
  $entity_id = $entity->id();

  $action = 'insert';
  AgriAdminHelper::addToLog(__function__);
  drupal_register_shutdown_function('_helper_update_process', $action, $entity_id, $entity->bundle());
  drupal_register_shutdown_function('_helper_locking_content', $action, $entity_id, $entity->bundle(), $entity);
}

/**
 * Implements hook_ENTITY_TYPE_update().
 */
function agri_admin_node_update(EntityInterface $entity) {
  $entity_id = $entity->id();
  $action = 'update';
  // AgriAdminHelper::addToLog(__function__);
  global $import_override;
  if (!isset($import_override) || $import_override == FALSE) {
    drupal_register_shutdown_function('_helper_update_process', $action, $entity_id, $entity->bundle());
    drupal_register_shutdown_function('_helper_locking_content', $action, $entity_id, $entity->bundle(), $entity);
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave().
 */
function agri_admin_node_presave(EntityInterface $entity) {
  // Exit early if possible.
  if ($entity->getEntityTypeId() != 'node') {
    return;
  }
  // Custom code goes here:
  global $import_override;

  $langcode = $entity->language()->getId();
  $menu_link_manager = \Drupal::service('plugin.manager.menu.link');
  $menu_links = $menu_link_manager->loadLinksByRoute('entity.node.canonical', ['node' => $entity->id()]);
  $menu_link = reset($menu_links);
  if ($menu_link) {
    $parent = $menu_link->getParent();
    if ($parent) {
      $parent = $menu_link_manager->createInstance($parent);
      // Get the current menu parent's url in UI.
      $parent_url = $parent->getUrlObject()->toString();
      $langprefix = '/' . $langcode;
      // Only compares parent's url/part and invalidate cache at the first time save
      // when current UI langcode == current UI parent menu link's langcode else the second time save, do nothing.
      if (isset($parent_url) && strpos($parent_url, $langprefix) !== FALSE) {
        $parent_url = str_replace($langprefix, '', $parent_url);
        $path = \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $entity->id(), $langcode);
        // Remove the last link of the path to get the parent path.
        $patharray = explode('/', $path);
        array_pop($patharray);
        array_shift($patharray);
        $parent_path = '';
        foreach ($patharray as $str) {
          $parent_path = $parent_path . '/' . $str;
        }
        if ($parent_url != $parent_path) {
          \Drupal::service('cache.render')->invalidateAll();
          \Drupal::service('cache.menu')->invalidateAll();
        }
      }
    }
  }

  $entity_id = $entity->id();
  // Set Authored by to current user if role is creator except during Peer Review.
  $current_author_id = $entity->getOwnerId();
  $current_user = \Drupal::currentUser();
  $current_user_id = $current_user->id();
  $roles = $current_user->getRoles();
  $authored_on = $entity->getCreatedTime();
  $content_type = $entity->bundle();

  if ($content_type == 'page' || $content_type == 'landing_page' || $content_type == 'empl' || $content_type == 'news') {
    $changed_time = $entity->getChangedTime();
    $date_issued = $entity->get('field_issued')->getString();
    $date_modified = $entity->get('field_modified')->getString();
    $moderation_state = $entity->moderation_state->value;
    $created_by = $entity->get('field_created_by')->getString();
    // AgriAdminHelper::addToLog(print_r('Current: '.$current_user, TRUE), TRUE);.
    if (empty($created_by)) {
      if ($entity->isNew()) {
        $entity->set('field_created_by', $current_user->getAccountName());
      }
      else {
        $admin_username = User::load(1)->getAccountName();
        $entity->set('field_created_by', $admin_username);
      }
    }

    $peer_review_status = '';
    if ($content_type == 'page' || $content_type == 'landing_page') {
      $update_date_modified_str = $entity->get('field_update_date_modified')->getString();
      $peer_review_status = $entity->get('field_peer_review')->getString();
      if ($moderation_state == 'published' || $moderation_state == 'archived') {
        $entity->set('field_peer_review', '');
      }
    }
    else {
      // Just making not zero and different from 1 for debug ease.
      $update_date_modified_str = '2';
    }

    $is_ia_role = FALSE;
    foreach ($roles as $role) {
      if ($role == 'ia') {
        $is_ia_role = TRUE;
        continue;
      }
    }
    if ($moderation_state == 'published') {
      $dt = new DateTime();
      if (empty($date_issued)) {
        $entity->set('field_issued', $dt->format('Y-m-d'));
        $entity->set('field_modified', $dt->format('Y-m-d'));
        $date_modified = $dt->format('Y-m-d');
        $date_issued = $date_modified;
      }

      if ($update_date_modified_str == '0' || $is_ia_role == TRUE || (isset($import_override) && $import_override)) {
        if(new DateTime($date_modified) > $dt) {
          $date_modified = $dt->format('Y-m-d');
          $entity->set('field_modified', $date_modified);
        }
        if(new DateTime($date_modified) < new DateTime($date_issued)) {
          $date_modified = $date_issued;
          $entity->set('field_modified', $date_modified);
        }

        // The changed field is translateable, must set value twice, otherwise unexpected issues during import.
        if ($entity->get('changed')->getFieldDefinition()->isTranslatable()) {
          // For some reason we enabled translation for changed field on this.
          if ($langcode == 'en') {
            if ($entity->hasTranslation('fr')) {
              $entity->getTranslation('fr')->set('changed', strtotime($date_modified));
            }
            if ($entity->hasTranslation('en')) {
              $entity->getTranslation('en')->set('changed', strtotime($date_modified));
            }
          }
          else {
            if ($entity->hasTranslation('en')) {
              $entity->getTranslation('en')->set('changed', strtotime($date_modified));
            }
            if ($entity->hasTranslation('fr')) {
              $entity->getTranslation('fr')->set('changed', strtotime($date_modified));
            }
          }
        }
        else {
          // If translation of this field is disabled make sure still works.
          $entity->set('changed', strtotime($date_modified));
        }
      }
      else {
        $entity->set('field_modified', $dt->format('Y-m-d'));
      }
    }

    // AgriAdminHelper::addToLog('update_date_modified_str: ' . $update_date_modified_str, TRUE);.
  }

  foreach ($roles as $value) {
    $role = $value;
    if (($role == 'creator' &&  empty($peer_review_status)) || $role == 'news_ccpub' || $role == 'empl_cspub') {
      // AgriAdminHelper::addToLog('presave called for ' . $entity->language()->getId() . ' ' . $entity->id(), TRUE);.
      $langcode = $entity->language()->getId();
      if ($langcode == 'en') {
        $entity->getTranslation('fr')->setOwnerId($current_user_id);
      }
      else {
        $entity->getTranslation('en')->setOwnerId($current_user_id);
      }
      $entity->setOwnerId($current_user_id);
    }
    $entity->set('created', time());
  }
}

/**
 * Helper function for content locking.
 *
 * @param string $action
 *   Is this operation an update or insert?
 * @param int $entity_id
 *   The id of the node.
 * @param string $bundle
 *   The content type, ex: 'page', 'landing_page'.
 * @param Drupal\node\NodeInterface $entity_obj
 *   The node that we need to lock or unlock.
 */
function _helper_locking_content($action, $entity_id, $bundle, NodeInterface $entity_obj = NULL) {
  global $import_override;
  $content_type = $entity_obj->bundle();
  if (!isset($import_override) || $import_override == FALSE) {
    if ($action == 'insert' || $action == 'update') {
      $current_user = \Drupal::currentUser();
      $current_user_id = $current_user->id();
      if ($action == 'update') {
        // AgriAdminHelper::getLatestRevision($entity_id, $vid);.
        $latest = $entity_obj;
      }
      if ($action == 'insert') {
        $latest = $entity_obj;
      }
      $current_author_id = $latest->getOwnerId();
      if (!isset($current_author_id)) {
        $current_author_id = $current_user_id;
      }

      $lock_service = \Drupal::service('content_lock');
      $is_creator = FALSE;
      $is_master = FALSE;
      $is_reviewer = FALSE;
      $roles = $current_user->getRoles();
      foreach ($roles as $value) {
        $role = $value;
        if ($role == 'news_ccpub' || $role == 'empl_cspub') {
          $is_master = TRUE;
          $state = $latest->get('moderation_state')->getString();
          if ($state == 'draft' || $state == 'review_by_reviewer' || $state == 'author_reviewing') {
            $lock_service->locking($entity_id, $latest->language()->getId(), 'edit', $current_user_id, $latest->getEntityTypeId());
            // Finished processing.
            return;
          }
          else {
            $lock_service->release($entity_id, $latest->language()->getId(), 'edit', $current_author_id, $latest->getEntityTypeId());
          }
        }
        if ($role == 'creator') {
          $is_creator = TRUE;
          $state = $latest->get('moderation_state')->getString();
          $peer_review_status = '';
          if ($content_type == 'page' || $content_type == 'landing_page') {
            $peer_review_status = $latest->get('field_peer_review')->getString();
          }
          if ($state == 'draft' && empty($peer_review_status)) {
            $lock_service->locking($entity_id, $latest->language()->getId(), 'edit', $current_user_id, $latest->getEntityTypeId());
            // Finished processing.
            return;
          }
          else {
            $lock_service->release($entity_id, $latest->language()->getId(), 'edit', $current_author_id, $latest->getEntityTypeId());
          }
        }
        if ($role == 'reviewer' && $state == 'with_reviewer') {
          $is_reviewer = TRUE;
          // Persist the lock for the reviewer.
          $lock_service->locking($entity_id, $latest->language()->getId(), 'edit', $current_user_id, $latest->getEntityTypeId());
          // Finished processing.
          return;
        }
      }
      // $original_state = $entity_obj->getOriginal('moderation_state')->getString();
      $state = $latest->get('moderation_state')->getString();
      if ($state == 'review_by_reviewer' && !$is_creator && !is_null($entity_obj)) {
        // @todo for Deepani - Call a function that sends an email to the reviewer role.
        // @todo Check the content type of $latest (entity) and do a case, possibly different group email per content type.
      }
      if ($state == 'author_reviewing' && !$is_creator && !is_null($entity_obj)) {
        // Reviewer is rejecting, sends back to author_reviewing, re-assigns the lock to the $current_author_id.
        $lock_service->locking($entity_id, $latest->language()->getId(), 'edit', $current_author_id, $latest->getEntityTypeId());
        // @todo for Deepani - Call a function that sends an email to $current_author_id (get author email address) and send email.
      }
      elseif (!$is_creator) {
        // Is neither reviewer, nor creator, therefore release all locks.
        $lock_service->release($entity_id, $latest->language()->getId(), 'edit', $current_user_id, $latest->getEntityTypeId());
        $lock_service->release($entity_id, $latest->language()->getId(), 'edit', $current_author_id, $latest->getEntityTypeId());
      }
    }
  }
}

/**
 * Processing to support internal page menu link behavior (disabled links).
 */
function _helper_update_process($action, $entity_id, $bundle) {
  global $import_override;
  if (!isset($import_override) || $import_override == FALSE) {
    AgriAdminHelper::addToLog('_helper_update_process action=' . $action . ' : ' . $entity_id . ' : ' . $bundle);
    $menu_link_ids = [];
    $menu_link_ids = AgriAdminHelper::postCreateOrUpdateAutoTranslate($action, $entity_id, $bundle);
    // AgriAdminHelper::postUpdateProcess($action, $entity_id, $bundle);.
    if ($bundle == 'page') {
      AgriAdminHelper::disableMenuLink(NULL, $entity_id, 'main', TRUE);
      AgriAdminHelper::disableMenuLink(NULL, $entity_id, 'sidebar');
    }

    if (\Drupal::currentUser()->isAuthenticated()) {
      $content_type = $bundle;
      $entity = \Drupal::entityTypeManager()->getStorage('node')->load($entity_id);
      if ($content_type == 'page') {
        if (isset($entity->moderation_state)) {
          $moderation_state = $entity->moderation_state->value;
          if ($moderation_state == 'archived') {
            if (AgriAdminHelper::menuLinkAction($entity_id, 'main', 'delete')) {
              AgriAdminHelper::addMessage(t('Menu link deleted for "%type" now "archived" node id: %id', [
                '%id' => $entity_id,
                '%type' => 'Internal page',
              ]
                )
              );
            }
            else {
              AgriAdminHelper::addMessage(t('Menu link not found for now "archived" %type node id: %id', [
                '%id' => $entity_id,
                '%type' => 'page',
              ]
                )
              );
            }
          }
        }
      }
      if ($content_type == 'landing_page') {
        if (isset($entity->moderation_state)) {
          $moderation_state = $entity->moderation_state->value;
          if ($moderation_state == 'archived') {
            if (AgriAdminHelper::menuLinkAction($entity_id, 'main', 'disable')) {
              AgriAdminHelper::addMessage(t('Menu link disabled for "%type" now "archived" node id: %id', [
                '%id' => $entity_id,
                '%type' => 'Landing page',
              ]
                )
              );
            }
            else {
              AgriAdminHelper::addMessage(t('Menu link not found for now "archived" %type node id: %id', [
                '%id' => $entity_id,
                '%type' => 'Landing page',
              ]
                )
              );
            }
          }
          if ($moderation_state != 'archived' && AgriAdminHelper::menuLinkExists($entity_id, 'main')) {
            $result_code = AgriAdminHelper::menuLinkAction($entity_id, 'main', 'enable');
          }
        }
      }
    }
  }
}


/**
 * Implements hook_form_node_news_form_alter().
 */
function agri_admin_form_node_news_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $route_match = Utils::getRouteName();
  if ($route_match == 'entity.node.canonical') {
    // For empl submit.
    $form['#attached']['library'][] = 'agri_admin/agri-news-submit';
    // For empl submit.
    $form['#attached']['library'][] = 'agri_admin/agri-empl-news-submit_css';
    if (\Drupal::currentUser()->isAuthenticated()) {
      // For empl submit.
      $form['#attached']['library'][] = 'agri_admin/agri-empl-news-submit-simple';
    }
    $form['actions']['preview']['#weight'] = -99;
    $form['actions']['#weight'] = 10;
    $form['actions']['submit']['#value'] = t('Submit');
  }
  if (\Drupal::currentUser()->isAnonymous()) {
    // Remove/do not render these form elements from anonymous user.
    $form['revision_log']['#access'] = FALSE;
    $form['revision_information']['#access'] = FALSE;
    $form['revision']['#access'] = FALSE;
    $form['field_keywords']['#access'] = FALSE;
    $form['field_description']['#access'] = FALSE;
    $form['moderation_state']['#access'] = FALSE;
    // End of remove these form elements from anonymous user:
    $form['actions']['preview']['#weight'] = -99;
    // See js/agri-empl-or-news-submit.js previewInNewTab().
    // For empl submit.
    $form['#attached']['library'][] = 'agri_admin/agri-empl-news-submit_css';
    $form['actions']['#weight'] = 10;
    $form['actions']['submit']['#value'] = t('Submit');
    // $form['#attributes']['target'] = '_blank';
    // $form['#attributes']['novalidate'] = 'novalidate';
  }
}

