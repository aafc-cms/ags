/**
 * Implements hook_preprocess_html().
 */
function agri_admin_preprocess_html(&$variables) {
  $current_path = \Drupal::service('path.current')->getPath();
  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $current_path = \Drupal::service('path.alias_manager')->getAliasByPath($current_path);
  $variables['current_path'] = $current_path;
  $clean_path = preg_replace( '/[\W]/', '', $variables['current_path']);
  if (strlen($clean_path) > 30) {
    $clean_path = substr($clean_path, 0, 29);
  }
  if (strpos($current_path, 'node') > 0) {
    if (substr_compare($current_path, 'edit', -strlen('edit')) === 0) {
      $clean_path = 'node-edit';
    }
  }
  $variables['attributes']['class'][] = $clean_path;
  $current_user = \Drupal::currentUser();
  $roles = $current_user->getRoles();
  foreach ($roles as $rolename) {
    $variables['attributes']['class'][] = 'role-is-' . $rolename;
  }
  $path = \Drupal::request()->getpathInfo();
  $arg  = explode('/',$path);
  if ($arg[0] == $langcode && isset($arg[2])) {
    $first_two_elements = $arg[1] . '-' . $arg[2];
  }
  if ($arg[1] == $langcode && isset($arg[3])) {
    $first_two_elements = $arg[2] . '-' . $arg[3];
  }
  if (isset($first_two_elements)) {
    $variables['attributes']['class'][] = $first_two_elements;
  }
}


/**
 * Implements hook_page_attachments().
 *
 * Adds the agri-admin libraries to each page.
 */
function agri_admin_page_attachments(array &$page) {
  $user = \Drupal::currentUser();
  if ($user->hasPermission('agrisource admin styles')) {
    $page['#attached']['library'][] = 'agri_admin/agri-admin';
  }
  return;
}

