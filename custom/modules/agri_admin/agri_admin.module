    'description' => t('A token to extract the current public facing URL in French'),
  ];
  return $info;
}

/**
 * Implements hook_tokens().
 */
function agri_admin_tokens($type, $tokens, array $data, array $options, BubbleableMetadata $bubbleable_metadata) {
  $replacements = [];
  if ($type == 'agri-admin' && isset($data['entity']) && $data['entity'] instanceof NodeInterface) {
    $entity = $data['entity'];
    if ($entity->hasTranslation('fr')) {
      $translated_entity = $entity->getTranslation('fr');
    }
    else {
      $translated_entity = $entity;
    }
    $translated_title = $translated_entity->getTitle();
    $translated_url = $translated_entity->toLink()->toString();
    $current_title = $entity->getTitle();
    $current_url = $entity->toLink()->toString();
    $transLangID = $translated_entity->language()->getId();
    $currentLangID = \Drupal::languageManager()->getCurrentLanguage()->getId();
    $nodeID = $entity->id();

    $host = \Drupal::request()->getHost();
    $anonymous_url = str_replace("-admin", "", $host);
    $publicFacing_str = '<a href="https://' . $anonymous_url . '/' . $currentLangID . '/node/' . $nodeID . '">' . $current_title . '</a>';
    $publicFacing_url = Markup::create($publicFacing_str);

    $currentLang = \Drupal::languageManager()->getCurrentLanguage();
    $hashTag = AgriAdminHelper::getHashTag($entity, $currentLang);
    $path = '<a href="' . $hashTag . '">' . $current_title . '</a>';
    $unpublished_url = Markup::create($path);

    $transLang = $translated_entity->language();
    $hashTagTrans = AgriAdminHelper::getHashTag($translated_entity, $transLang);
    $transPath = '<a href="' . $hashTagTrans . '">' . $translated_title . '</a>';
    $translated_unpublished_url = Markup::create($transPath);

    $transPublicFacing_str = '<a href="https://' . $anonymous_url . '/' . $transLangID . '/node/' . $nodeID . '">' . $translated_title . '</a>';
    $translated_publicFacing_url = Markup::create($transPublicFacing_str);
    foreach ($tokens as $name => $original) {
      // Find the desired token by name.
      switch ($name) {
        case 'translation-title':
          $replacements[$original] = $translated_title;
          break;

        case 'translation-url':
          $replacements[$original] = $translated_url;
          break;

        case 'title':
          $replacements[$original] = $current_title;
          break;

        case 'url':
          $replacements[$original] = $current_url;
          break;

        case 'unpublished-url':
          $replacements[$original] = $unpublished_url;
          break;

        case 'translation-unpublished-url':
          $replacements[$original] = $translated_unpublished_url;
          break;

        case 'public-facing-url':
          $replacements[$original] = $publicFacing_url;
          break;

        case 'translation-public-facing-url':
          $replacements[$original] = $translated_publicFacing_url;
          break;
      }
    }
  }
  // Add token for webform only.
  if ($type == 'agri-admin' && !(isset($data['entity']) && $data['entity'] instanceof NodeInterface)) {
    foreach ($tokens as $name => $original) {
      switch ($name) {
        case 'user-agent':
          $useragent = $_SERVER['HTTP_USER_AGENT'];
          $replacements[$original] = $useragent;
          break;
      }
    }
  }
  return $replacements;
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function agri_admin_form_menu_link_content_menu_link_content_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if ($form_id = 'menu_link_content_menu_link_content_form') {
    // AgriAdminHelper::addToLog('form_id ' . $form_id, TRUE);.
    // For hiding disabled items adding checkbox.
    $form['#attached']['library'][] = 'agri_admin/menu-navigation-hide-disabled';
  }

  // @todo convert this logic into a contrib module, BEGIN MENU EDIT/ADD LINK OPTIMISATION HERE:
  $route_match = Utils::getRouteName();
  $current_path = \Drupal::service('path.current')->getPath();
  // Retrieve an array which contains the path pieces.
  $path_args = explode('/', $current_path);
  $menu_link_add_or_edit_optimize = FALSE;
  $menu_name = '';

  if ($route_match == 'entity.menu.add_link_form' && isset($path_args[6])) {
    if ($path_args[4] == 'manage' && $path_args[6] == 'add') {
      $menu_link_add_or_edit_optimize = TRUE;
      $menu_name = $path_args[5] . ':';
    }
  }

  if ($route_match == 'entity.menu_link_content.canonical' && isset($path_args[6])) {
    if ($path_args[4] == 'item' && $path_args[6] == 'edit' && is_numeric($path_args[5])) {
      $mlid = $path_args[5];
      $link = AgriAdminHelper::getMenuLinkFromMlid($mlid);
      $menu_name = $link->getMenuName() . ':';
      // Always disable other menu items, speeds up logic for James logic.
      $menu_link_add_or_edit_optimize = TRUE;
      // $current_user = \Drupal::currentUser();
      // $current_user_id = $current_user->id();
      // $roles = $current_user->getRoles();
      // if (!in_array('administrator', $roles)) {
      //   // Only non-Administrators should see the optimized menu for menu link EDIT.
      //   // We want administrators to be able to move this link around if they wish.
      //   $menu_link_add_or_edit_optimize = TRUE;
      // }
    }
  }
  if ($menu_link_add_or_edit_optimize) {
    foreach ($form['menu_parent']['#options'] as $key => &$value) {
      if (isset($key) && strpos($key, $menu_name) === FALSE) {
        unset($form['menu_parent']['#options'][$key]);
      }
      else {
        // Check interface lang code, if english, look for 'disabled' value.
        // Then if NOT disabled, call logic or function.
        // Check interface lang code, if french, look for 'désactivé' value.
        // Then if NOT désactivé, call logic or function.
        $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
        if ($langcode == 'en' && isset($value) && strpos($value, 'disabled') == FALSE) {
          $keyarray = explode(":", $key);
          if (count($keyarray) > 2) {
            if (AgriAdminHelper::isLinkFrenchOnly($keyarray[2])) {
              unset($form['menu_parent']['#options'][$key]);
            }
          }
        }
        else {
          if ($langcode == 'fr' && isset($value) && strpos($value, 'désactivé') == FALSE) {
            $keyarray = explode(":", $key);
            if (count($keyarray) > 2) {
              if (AgriAdminHelper::isLinkEnglishOnly($keyarray[2])) {
                unset($form['menu_parent']['#options'][$key]);
              }
            }
          }
        }
      }
    }
  }
  // @todo END OF MENU EDIT/ADD LINK OPTIMISATION.
  foreach ($form['menu_parent']['#options'] as $key => &$value) {
    if (isset($value) && strpos($value, '-- ') == 0) {
      // $value =  substr($value,0, 3) . 'level 1. ' . substr( $value,3, strlen($value)) ;
      $form['menu_parent']['#options_attributes'][$key]['class'] = ['class' => 'menu_tree-leve-1'];
    }
    else {
      if (isset($value) && strpos($value, '---- ') == 0) {
        // $value =  substr($value,0, 5) . 'level 2. ' . substr( $value,5, strlen($value)) ;
        $form['menu_parent']['#options_attributes'][$key]['class'] = 'menu_tree-leve-2 glyphicon';
      }
      else {
        if (isset($value) && strpos($value, '------ ') == 0) {
          // $value =  substr($value,0, 7) . 'level 3. ' . substr( $value,7, strlen($value)) ;
          $form['menu_parent']['#options_attributes'][$key]['class'] = 'menu_tree-leve-3';
        }
        else {
          if (isset($value) && strpos($value, '-------- ') == 0) {
            // $value =  substr($value,0, 9) . 'level 4. ' . substr( $value,9, strlen($value)) ;
            $form['menu_parent']['#options_attributes'][$key]['class'] = 'menu_tree-leve-4';
          }
          else {
            if (isset($value) && strpos($value, '---------- ') == 0) {
              // $value =  substr($value,0, 11) . 'level 5. ' . substr( $value,11, strlen($value)) ;
              $form['menu_parent']['#options_attributes'][$key]['class'] = 'menu_tree-leve-5';
            }
            else {
              if (isset($value) && strpos($value, '------------ ') == 0) {
                // $value =  substr($value,0, 13) . 'level 6. ' . substr( $value,11, strlen($value)) ;
                $form['menu_parent']['#options_attributes'][$key]['class'] = 'menu_tree-leve-6';
              }
            }
          }
        }
      }
    }
  }
}

/**
 * Implements agri_admin_views_pre_render() hook.
 */
function agri_admin_views_pre_render(ViewExecutable $view) {
  if ($view->id() != 'content' && $view->id() != 'moderated_content') {
    return;
  }

  $user_roles = \Drupal::currentUser()->getRoles();
  if (in_array('empl_cspub', $user_roles)) {
    $filters = $view->getDisplay()->getOption('filters');
    $filters['type']['value'] = 'empl';
    $view->display_handler->overrideOption('filters', $filters);
  }

  if (in_array('news_ccpub', $user_roles)) {
    $filters = $view->getDisplay()->getOption('filters');
    $filters['type']['value'] = 'news';
    $view->display_handler->overrideOption('filters', $filters);
  }
}

/**
 * Implements agri_admin_form_views_exposed_form_alter hook.
 */
function agri_admin_form_views_exposed_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $view = $form_state->getStorage('view');
  if ($view['view']->id() != 'content' && $view['view']->id() != 'moderated_content') {
    return;
  }

  $route_match = Utils::getRouteName();
  if ($route_match == 'content_moderation.admin_moderated_content') {
    if ($view['view']->id() == 'moderated_content') {
      $form['#attached']['library'][] = 'agri_admin/agri_moderated_content';
    }
  }

  if (isset($form['type']['#options'])) {
    // Ensure that "- Any -" is 'first', and the other type options are in alphanum order.
    ksort($form['type']['#options']);
  }

  $user_roles = \Drupal::currentUser()->getRoles();
  if (in_array('empl_cspub', $user_roles) && ($form_id == 'views_exposed_form')) {
    // Solve Drupal 9 being more strict about allowed filter values, must also set input in Drupal 9.
    $input = $form_state->getUserInput();
    foreach ($form['type']['#options'] as $key => &$value) {
      $key_label = $form['type']['#options'][$key];
      if (($key != 'empl') && (stripos($key_label, 'empl') === FALSE)) {  // additional condition to handle grouped filters
        unset($form['type']['#options'][$key]);
      }
      else {
        $form['type']['#default_value'] = $value;
        $input['type'] = $key;
        $form_state->setUserInput($input);
      }
    }
  }

  if (in_array('news_ccpub', $user_roles) && ($form_id == 'views_exposed_form')) {
    // Solve Drupal 9 being more strict about allowed filter values, must also set input in Drupal 9.
    $input = $form_state->getUserInput();
    foreach ($form['type']['#options'] as $key => &$value) {
      $key_label = $form['type']['#options'][$key];
      if (($key != 'news') && (stripos($key_label, 'news') === FALSE) && (stripos($key_label, 'nouv') === FALSE)) {  // additional condition to handle grouped filters
        unset($form['type']['#options'][$key]);
      }
      else {
        $form['type']['#default_value'] = $key;
        $input['type'] = $key;
        $form_state->setUserInput($input);
      }
    }
  }

  if (($form_id == 'views_exposed_form') && ($view['view']->id() == 'moderated_content')){
    $input = $form_state->getUserInput();
    if (isset($input['moderation_state'])) {
      $key = $input['moderation_state'];
      // To fix issues introduced in Drupal 10.
      if (!is_string($key)) {
        $input['moderation_state'] = 'All';
        $form_state->setUserInput($input);        
      } else {
        $key_label = $form['moderation_state']['#options'][$key];
        // Including additional condition to handle grouped filters.
        if (($key !== 'draft') && (stripos($key_label, 'draft') === FALSE) && (stripos($key_label, 'brouillon') === FALSE)) {
          $input['status'] = 'All';
          $form_state->setUserInput($input);
        }
      }
    }
  }
}

/**
 * Implements hook_file_validate().
 */
function agri_admin_file_validate(FileInterface $file) {
  if (!(\Drupal::config('filehash.settings')->get('dedupe'))) {
    agri_admin_validate_dedupe_warning($file);
  }
}

/**
 * Checks that file is not a duplicate.
 */
function agri_admin_validate_dedupe_warning(FileInterface $file) {
  $warnings = [];
  $warning = '';
  $langId = \Drupal::languageManager()->getCurrentLanguage()->getId();
  if (!$file->id()) {
    $tablename = AgriAdminHelper::getHashTableName();
    foreach (agri_admin_algos() as $algo) {
      $query = \Drupal::database()->select('{' . $tablename . '}');
      $query->addField('{' . $tablename . '}', 'fid');
      $query->condition($algo, $file->filehash[$algo]);
      $query->range(0, 1);

      if ($fid = $query->execute()->fetchField()) {
        if (\Drupal::currentUser()->hasPermission('access files overview')) {
          try {
            $url = Url::fromRoute('view.files.page_2', ['arg_0' => $fid], ['attributes' => ['target' => '_blank']]);
            $filename = Link::fromTextAndUrl(File::load($fid)->label(), $url)->toString();
            if ($langId == 'en') {
              $warning = Markup::create('This file has already been uploaded as ' . $filename . '.');
            }
            else {
              $warning = Markup::create('Ce fichier a déjà été téléchargé en tant que ' . $filename . '.');
            }
          }
          catch (Exception $e) {
            // Maybe the view was disabled?
            \Drupal::messenger()->addWarning($e->getMessage(), TRUE);
          }
        }
        else {
          if ($langId == 'en') {
            $warning = 'This file has already been uploaded.';
          }
          else {
            $warning = 'Ce fichier a déjà été téléchargé.';
          }
        }
        array_push($warnings, $warning);
        break;
      }
    }
  }
  // Ouput all warning messages.
  foreach ($warnings as $msg) {
    \Drupal::messenger()->addWarning($msg, TRUE);
  }
  return [];
}

/**
 * Returns array of enabled hash algorithms.
 */
function agri_admin_algos() {
  return array_diff(\Drupal::config('filehash.settings')->get('algos'), [0]);
}

/**
 * Implements hook_form_alter().
 */
function agri_admin_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  if (isset($form_id) && strpos($form_id, 'media') !== FALSE && strpos($form_id, 'delete') !== FALSE) {
    $path = \Drupal::request()->getpathInfo();
    $arg = explode('/', $path);
    $index_arg = 0;
    $idx = 0;
    foreach ($arg as $segment) {
      if (is_numeric($segment) && !is_bool($segment)) {
        $index_arg = $idx;
      }
      $idx++;
    }
    if (isset($arg[$index_arg]) && is_numeric($arg[$index_arg])) {
      $mid = $arg[$index_arg];
    }
    else {
      // This should never happen.
      return;
    }
    $media = Media::load($mid);
    $media_name = $media->getName();

    $show_button = TRUE;
    if (isset($media_name) && strpos($media_name, 'Home Slideshow Thumbnav') !== FALSE) {
      $show_button = FALSE;
    }
    if (!$show_button) {
      \Drupal::messenger()->addMessage(
        t('"%title" cannot be deleted because it is required for proper SlideShow functionality!', [
          '%title' => $media_name,
        ]
        ), 'error', TRUE);
      $form['actions']['submit']['#attributes'] = [
        'disabled' => $show_button ? 'enabled' : 'disabled',
      ];
    }
  }

}

/**
 * Implements hook_entity_type_predelete().
 */
function agri_admin_media_predelete(EntityInterface $entity) {
  $media_name = $entity->getName();
  if (isset($media_name) && strpos($media_name, 'Home Slideshow Thumbnav') !== FALSE) {
    $entity_type = $entity->getEntityTypeId();
    $id = $entity->id();
    // This message does not seem to work inside this function.
    \Drupal::messenger()->addMessage(t('"%title" cannot be deleted because it is required for proper SlideShow functionality!', [
      '%title' => $media_name,
    ]), 'error', TRUE);

    $response = new RedirectResponse(Url::fromUri('internal:/' . $entity_type . '/' . $id . '/edit')->toString());
    $response->send();
    exit;
  }
}
