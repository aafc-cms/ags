/**
 * Implements agri_admin_form_submit().
 */
function agri_admin_form_newsorempl_submit (array $form, \Drupal\Core\Form\FormStateInterface $form_state){
  $current_user = \Drupal::currentUser();
  if ($current_user->isAnonymous()) {
    $entity = $form_state->getFormObject()->getEntity();
    $entity->set('moderation_state', 'draft');
    $front_url = Url::fromRoute('<front>');
    $form_state->setRedirectUrl( $front_url );
  }
}

/**
 * Implements hook_form_node_form_alter().
 */
function agri_admin_form_node_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $entity = $form_state->getFormObject()->getEntity();

  $content_type = $entity->bundle();
  if ($content_type == 'page' || $content_type == 'landing_page' || $content_type == 'empl' || $content_type == 'news') {
    $form['field_issued']['widget'][0]['#disabled'] = TRUE;
    $form['field_modified']['widget'][0]['#disabled'] = TRUE;
    $form['field_created_by']['widget'][0]['#disabled'] = TRUE;
    $form['field_dc_date_created']['widget'][0]['#disabled'] = TRUE;
    $form['#attached']['library'][] = 'agri_admin/page'; // For page and landing page edit/add css.
    //add validation functionality to prevent the broken links or misused linkit before the page is published.
    if ($content_type == 'page' || $content_type == 'landing_page') {
      $form['#validate'][] = 'agri_admin_publishpage_referredlinks_validation';
    }
    // custom action after the data is submitted.
    //$form['actions'][$action]['#submit'][] = 'agri_admin_form_submit'i;
    $current_user = \Drupal::currentUser();
    if ($current_user->isAnonymous()) {
      foreach (array_keys($form['actions']) as $action) {
        if ($action != 'preview' && isset($form['actions'][$action]['#type']) && $form['actions'][$action]['#type'] === 'submit') {
          $form['actions'][$action]['#submit'][] = 'agri_admin_form_newsorempl_submit';
        }
      }
    }

//  AgriAdminHelper::addToLog($debug_message, TRUE);
//Copying fields to label:
    if (isset($form['field_dc_date_created']['widget'][0])) {
      $date_created_date = $form['field_dc_date_created']['widget'][0]['value']['#default_value'];
      if (is_object($date_created_date)) {
        $form['field_dc_date_created']['widget'][0]['value']['#title'] = t('dc.date.created') . ': ' . $date_created_date->format('Y-m-d');
      }
      else {
        $form['field_dc_date_created']['widget'][0]['value']['#title'] = t('dc.date.created') . ':';
      }
      $form['field_dc_date_created']['#attributes']['class'] = 'hidden-input-box';
    }

    if (isset($form['field_created_by']['widget'][0])) {
      $created_by = $form['field_created_by']['widget'][0]['value']['#default_value'];
      if (!empty($created_by)) {
        $form['field_created_by']['widget'][0]['value']['#title'] = t('Created by') . ': ' . $created_by;
      }
      else {
        $form['field_created_by']['widget'][0]['value']['#title'] = t('Created by') . ':';
      }
      $form['field_created_by']['#attributes']['class'] = 'hidden-input-box';
    }

    if (isset($form['field_issued']['widget'][0])) {
      $date_issued = $form['field_issued']['widget'][0]['value']['#default_value'];
      if (is_object($date_issued)) {
        $form['field_issued']['widget'][0]['value']['#title'] = t('dcterms:issued') . ': ' . $date_issued->format('Y-m-d');
      }
      else {
        $form['field_issued']['widget'][0]['value']['#title'] = t('dcterms:issued') . ':';
      }
      $form['field_issued']['#attributes']['class'] = 'hidden-input-box';
    }

    if (isset($form['field_modified']['widget'][0])) {
      $date_modified = $form['field_modified']['widget'][0]['value']['#default_value'];
      if (is_object($date_modified)) {
        $form['field_modified']['widget'][0]['value']['#title'] = t('dcterms:modified') . ': ' . $date_modified->format('Y-m-d');
      }
      else {
        $form['field_modified']['widget'][0]['value']['#title'] = t('dcterms:modified') . ':';
      }
      $form['field_modified']['#attributes']['class'] = 'hidden-input-box';
    }

    if ($content_type == 'page' || $content_type == 'landing_page') {
      $moderation_state = $entity->moderation_state->value;
      $peer_review_status = $entity->get('field_peer_review')->getString();

      if ($entity->isNew()) {
        $form['field_peer_review']['#disabled'] = TRUE;
      }
      elseif ($moderation_state == 'published' || $moderation_state == 'archived') {
          $form['field_peer_review']['#disabled'] = TRUE;
          $form['field_tracking_number']['widget'][0]['value']['#default_value'] = '';
      }
      elseif ($moderation_state == 'draft' &&  empty($peer_review_status)) {
        // Do not enable peer reviewed.
        $form['field_peer_review']['widget']['#options_attributes']['peer_reviewed']['disabled'] = 'disabled';
      }
    } //End handle Peer_Review for page/landing_page only.
  }// End page/landing_page/news/empl.

  // Change expiry date field as a required field for node_news_edit_form
  if ($form_id == 'node_news_edit_form') {
    if (User::load(\Drupal::currentUser()->id())->hasRole('news_ccpub')) {
      if (isset($form['field_newsexpirydate'])) {
        $form['field_newsexpirydate']['widget'][0]['#required'] = TRUE;
        $form['field_newsexpirydate']['#required'] = TRUE;
        $form['field_newsexpirydate']['#element_validate'][] = 'agri_admin_expirydatevalidator';
      }
    }
  }

  $current_user = \Drupal::currentUser();
  $roles = $current_user->getRoles();
  foreach ($roles as $role) {
    if ($role == 'ia') {
      foreach ($form as $key => $value) {
        if (isset($value)) {
          if(strpos($key, '_meta') == false) {
            if(strpos($key, 'field_') !== false) {
              $form[$key]['#disabled'] = TRUE;
            }
          }
        }
      }
      $form['title']['#disabled'] = TRUE;
      $form['layout_selection']['#disabled'] = TRUE;
      $form['field_description']['#disabled'] = FALSE;
      $form['field_keywords']['#disabled'] = FALSE;
      $form['field_subject']['#disabled'] = FALSE;
    }
  }
}

/**
 * Implements custom validation for checking three cases when the user publishes the page
 * Case #1: The link contains token
 * Case #2: The link refers unpublished node
 * Case #3: The link uses absolute URL path
 */
function agri_admin_publishpage_referredlinks_validation(&$form, &$form_state) {
  $langcode = \Drupal\agri_admin\AgriAdminHelper::getLang();
  // default language - body field
  //Since it is in validation stage, i have to get the body value from $form variable instead of node entity
  $formbodydefault =$form['body']['widget'][0]['value']['#value'];
  $formbody2 ="";
  if ($langcode == 'en') {
    $formbody2 =$form['body']['fr']['widget'][0]['value']['#value'];
  }
  else {
    $formbody2 =$form['body']['en']['widget'][0]['value']['#value'];
  }
  $entity = $form_state->getFormObject()->getEntity();
  $nType = $entity->bundle();

  // get the moderation state value from form values
  $formvalues = $form_state->getValues();
  $tmp = array_pop($formvalues['moderation_state']);
  $node_mstate = array_pop($tmp);
  if (( $nType == 'page' || $nType == 'landing_page') && ($node_mstate == 'published')) {
    $foundtokenhref = FALSE;
    agri_admin_checkurltoken($formbodydefault, $foundtokenhref, $langcode);
    agri_admin_checkurltoken($formbody2, $foundtokenhref, $langcode);

    // check unpublished node
    $foundunpublishingnode = FALSE;
    agri_admin_checkpagepublished($formbodydefault, $foundunpublishingnode, $langcode);
    agri_admin_checkpagepublished($formbody2, $foundunpublishingnode, $langcode);

    // check absolute URL
    $foundabsoluteurl = FALSE;
    agri_admin_checkabsoluteurl($formbodydefault, $foundabsoluteurl, $langcode);
    agri_admin_checkabsoluteurl($formbody2, $foundabsoluteurl, $langcode);

    //prevent the user to publish the page.
    if ($foundtokenhref || $foundunpublishingnode || $foundabsoluteurl) {
      $form_state->setRebuild();
    }
  }
}


/**
 * Implements check if the href contains token before the user publishes the current page
 *
 */
function agri_admin_checkurltoken($formbody, &$foundtokenhref = FALSE, $langcode = 'en') {
  // token string pattern
  $tokenmsg = '';
  if ($langcode == 'en') {
    $tokenmsg = '<p style="color:#e0ac00; font-size:16px;"><strong>Please remove the token and make sure they are published before you publish the current one. <br/>If the link contains an absolute url, please use Linkit to change the reference to relative URL.</strong></p>';
  }
  else {
    $tokenmsg = '<p style="color:#e0ac00; font-size:16px;"><strong>Veuillez supprimer le jeton et assurez-vous qu\'ils sont publiés avant de publier le jeton actuel. <br/>Si le lien contient une URL absolue, veuillez utiliser Linkit pour modifier la référence en URL relative.</strong></p>';
  }
  $tokenmsgarray = array();
  \Drupal\agri_admin\Utils::checkUrlToken($formbody, $foundtokenhref, $tokenmsgarray);
  if ($foundtokenhref) {
    $warning = Markup::create($tokenmsg);
    \Drupal::messenger()->addWarning($warning);
    foreach($tokenmsgarray as $msg) {
      $warning = Markup::create($msg);
      \Drupal::messenger()->addWarning($warning);
    }
  }
  return $foundtokenhref;
}


/**
 * Implements check if the href page is published before the user publishes the current page
 *
 */
function agri_admin_checkpagepublished($formbody, &$foundunpublishingnode = FALSE, $langcode = 'en') {
  $unpublishingnodemsg = '';
  if ($langcode == 'en') {
    $unpublishingnodemsg = '<p style="color:#e0ac00; font-size:16px;"><strong>Please publish the identified pages first and then publish the current one.</strong></p>';
  }
  else {
    $unpublishingnodemsg = '<p style="color:#e0ac00; font-size:16px;"><strong>Veuillez d\'abord publier les pages identifiées, puis publier la page actuelle.</strong></p>';
  }
  $regex_mediaobj = "/data-entity-type=\"node\" data-entity-uuid=\"([a-z]|[0-9]){8}-(([0-9]|[a-z]){4}-){3}([0-9]|[a-z]){12}\"/";
  $regex_uuid = "/([a-z]|[0-9]){8}-(([0-9]|[a-z]){4}-){3}([0-9]|[a-z]){12}/";
  $publishpagemsgarray = array();
  \Drupal\agri_admin\Utils::checkPagePublished($formbody, $foundunpublishingnode, $publishpagemsgarray);
  if ($foundunpublishingnode) {
    $warning = Markup::create($unpublishingnodemsg);
    \Drupal::messenger()->addWarning($warning);
    foreach($publishpagemsgarray as $msg) {
      $warning = Markup::create($msg);
      \Drupal::messenger()->addWarning($warning);
    }
  }
  return $foundunpublishingnode;
}


/**
 * Implements check if the href url is absolute URL before the user publishes the current page
 *
 */
function agri_admin_checkabsoluteurl($formbody, &$foundabsoluteurl = FALSE, $langcode = 'en') {
  $absoluteurlmsg ='';
  if ($langcode == 'en') {
    $absoluteurlmsg = '<p style="color:#e0ac00; font-size:16px;"><strong>Please use Linkit to complete the reference.</strong></p>';
  }
  else {
    $absoluteurlmsg = '<p style="color:#e0ac00; font-size:16px;"><strong>Veuillez utiliser Linkit pour compléter la référence.</strong></p>';
  }
  $absoluteurlmsgarray = array();
  \Drupal\agri_admin\Utils::checkAbsoluteUrl($formbody, $foundabsoluteurl, $absoluteurlmsgarray);
  if ($foundabsoluteurl) {
    $warning = Markup::create($absoluteurlmsg);
    \Drupal::messenger()->addWarning($warning);
    foreach($absoluteurlmsgarray as $msg) {
      $warning = Markup::create($msg);
      \Drupal::messenger()->addWarning($warning);
    }
  }

  return $foundabsoluteurl;
}

/**
 * Implements hook_expirydate.
 * for node_news_edit_form
 */
function agri_admin_expirydatevalidator($element, &$form_state) {
  if ((empty($element['widget'][0]['value']['#value']['date'])) ) {
     $form_state->setErrorByName('field_newsexpirydate');
  }
}


/**
 * Implements hook_system_breadcrumb_alter().
 * for /node/add/news page
 */
function agri_admin_system_breadcrumb_alter(\Drupal\Core\Breadcrumb\Breadcrumb &$breadcrumb, \Drupal\Core\Routing\RouteMatchInterface $route_match, array $context) {
  $current_path = \Drupal::service('path.current')->getPath();
  $result = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
  $previousUrl = \Drupal::request()->server->get('HTTP_REFERER');
  $node_preview = \Drupal::routeMatch()->getParameter('node_preview');
  $node = \Drupal::routeMatch()->getParameter('node');
  $nid = 0;
  $nType = '';
  if ($node_preview) {
    $nType = $node_preview->getType();
  }
  if (isset($node) && !is_string($node) && is_object($node) && method_exists($node, 'getType')) {
    $nType = $node->getType();
    $nid = $node->id();
  }
  if (isset($breadcrumb)) {
    $links = $breadcrumb->getlinks();
    if (is_array($links) && isset($links[0])) {
      $first_breadcrumb_text = $links[0]->getText();
      if ($first_breadcrumb_text == 'Agrisource') {
        // Make sure that the first breadcrumb link starts with 'Home' instead of 'Agrisource'.
        $links[0]->setText(t('Home'));
      }
    }
  }

  //handle /node/preview page for News
  if (((strpos($result,'/node/preview/') !==false) && ($nType == 'news'))
    && (\Drupal::currentUser()->isAnonymous())) {
    if ($breadcrumb) {
      $links = $breadcrumb->getlinks();
      $breadcrumb = new \Drupal\Core\Breadcrumb\Breadcrumb();
      $breadcrumb->addLink($links[0]);
      // dynamically handle the route name for News link
      $news = \Drupal::entityTypeManager()->getStorage('node')->getQuery()
        ->condition('title', 'news', '=')
        ->execute();
      if ($news) {
        $langcode = \Drupal\agri_admin\AgriAdminHelper::getLang();
        if (is_array($news)) {
          $first_nid = array_shift($news);
          $news = \Drupal::entityTypeManager()->getStorage('node')->load($first_nid);
        }
        if ($news->hasTranslation($langcode)) {
          $news = $news->getTranslation($langcode);
        }
        $linkNews = $news->toLink($news->getTitle());
      }
      else {
        $linkNews = Link::createFromRoute(t('News'), 'view.view_news_work.page_1');
      }
      $breadcrumb->addLink($linkNews);
      // The following query is not necessary if the news@work breadcrumb is a view route, however if it is a node then it is.
      // During our development cycle news@work was sometimes a node as it was imported this way from legacy.
      // However the actual news@work page is a view page now.
      $news_at_work = \Drupal::entityTypeManager()->getStorage('node')->getQuery()
        ->condition('title', 'news@work', '=')
        ->execute();
      if (is_array($news_at_work)) {
        $first_nid = array_shift($news_at_work);
        if ((is_numeric($first_nid) && $first_nid > 0) || strlen((string) $first_nid) == 36 ) {
          // The above if statement is to avoid an array_flip warning from core.
          // If the news@work breadcrumb item is a view page then we should never need to load this.
          $news_at_work = \Drupal::entityTypeManager()->getStorage('node')->load($first_nid);
        }
      }
      if ($news_at_work) {
        // This condition is only true if the news@work breadcrumb item is a node,
        // however in the current design it is currently a view page.
        $langcode = \Drupal\agri_admin\AgriAdminHelper::getLang();
        if ($news_at_work->hasTranslation($langcode)) {
          $news_at_work = $news_at_work->getTranslation($langcode);
        }
        $linkNewsatWork = $news_at_work->toLink($news_at_work->getTitle());
      }
      else {
        $linkNewsatWork = Link::createFromRoute(t('News@work'), 'view.view_news_work.page_1');
      }
      $breadcrumb->addLink($linkNewsatWork);
    }
  }

  // handle /node/preview page for Employment Opportunity form
  if (((strpos($result,'/node/preview/') !==false) && ($nType == 'empl'))
    && (\Drupal::currentUser()->isAnonymous())) {
    if ($breadcrumb) {
      $links = $breadcrumb->getlinks();
      $breadcrumb = new \Drupal\Core\Breadcrumb\Breadcrumb();
      $breadcrumb->addLink($links[0]);
      // dynamically handle the route name for EO link
      $hr = \Drupal::entityTypeManager()->getStorage('node')->getQuery()
        ->condition('title', 'Human Resources – Services and Information', '=')
        ->execute();
      if ($hr) {
        $langcode = \Drupal\agri_admin\AgriAdminHelper::getLang();
        if (is_array($hr)) {
          $first_nid = array_shift($hr);
          $hr = \Drupal::entityTypeManager()->getStorage('node')->load($first_nid);
        }
        if ($hr->hasTranslation($langcode)) {
          $hr = $hr->getTranslation($langcode);
        }
        $linkHR = $hr->toLink(t('Human Resources'));
      }
      else {
        $linkHR = Link::createFromRoute(t('Human Resources'), 'view.view_employmentopportunities.page_1');
      }
      $breadcrumb->addLink($linkHR);

      // manually add the Internal Employment Opportunities view here to match Josep's change
      $linkview_employmentopportunities = Link::createFromRoute(t('Internal Employment Opportunities'), 'view.view_employmentopportunities.page_1');
      $breadcrumb->addLink($linkview_employmentopportunities);
    }
  }
  else if ($nid == 50 || Utils::getRouteName() == 'view.view_employmentopportunities.page_1' || (isset($nType) && $nType == 'empl')) {
    if ($breadcrumb) {
      foreach($links as $key => $link) {
        if ($link->getText() == 'Human Resources – Services and Information') {
          $link->setText('Human Resources');
        }
        else if ($link->getText() == 'Ressources humaines – Services et renseignements') {
          $link->setText('Ressources humaines');
        }
      }
    }
  }

  if (($result =='/node/add/news') && (\Drupal::currentUser()->isAnonymous())) {
    if ($breadcrumb) {
      $links = $breadcrumb->getlinks();
      $breadcrumb = new \Drupal\Core\Breadcrumb\Breadcrumb();
      $breadcrumb->addLink($links[0]);
      // dynamically handle the route name for News link
      $news = \Drupal::entityTypeManager()->getStorage('node')->getQuery()
        ->condition('title', 'news', '=')
        ->execute();
      if ($news) {
        $langcode = \Drupal\agri_admin\AgriAdminHelper::getLang();
        if (is_array($news)) {
          $first_nid = array_shift($news);
          $news = \Drupal::entityTypeManager()->getStorage('node')->load($first_nid);
        }
        if ($news->hasTranslation($langcode)) {
          $news = $news->getTranslation($langcode);
        }
        $linkNews = $news->toLink($news->getTitle());
      }
      else {
        $linkNews = Link::createFromRoute(t('News'), 'view.view_news_work.page_1');
      }
      $breadcrumb->addLink($linkNews);
      //Dynamically handle the route name for news at work link
      // The following query is not necessary if the news@work breadcrumb is a view route, however if it is a node then it is.
      // During our development cycle news@work was sometimes a node as it was imported this way from legacy.
      // However the actual news@work page is a view page now.
      $news_at_work = \Drupal::entityTypeManager()->getStorage('node')->getQuery()
        ->condition('title', 'news@work', '=')
        ->execute();
      if (is_array($news_at_work)) {
        $first_nid = array_shift($news_at_work);
        if ((is_numeric($first_nid) && $first_nid > 0) || strlen((string) $first_nid) == 36 ) {
          // The above if statement is to avoid an array_flip warning from core.
          // If the news@work breadcrumb item is a view page then we should never need to load this.
          $news_at_work = \Drupal::entityTypeManager()->getStorage('node')->load($first_nid);
        }
      }
      if ($news_at_work) {
        // This condition is only true if the news@work breadcrumb item is a node,
        // however in the current design it is currently a view page.
        $langcode = \Drupal\agri_admin\AgriAdminHelper::getLang();
        if ($news_at_work->hasTranslation($langcode)) {
          $news_at_work = $news_at_work->getTranslation($langcode);
        }
        $linkNewsatWork = $news_at_work->toLink($news_at_work->getTitle());
      }
      else {
        $linkNewsatWork = Link::createFromRoute(t('News@work'), 'view.view_news_work.page_1');
      }
      $breadcrumb->addLink($linkNewsatWork);
    }
  }

  if (($result =='/node/add/empl') && (\Drupal::currentUser()->isAnonymous())) {
    if ($breadcrumb) {
      $links = $breadcrumb->getlinks();
      $breadcrumb = new \Drupal\Core\Breadcrumb\Breadcrumb();
      $breadcrumb->addLink($links[0]);
      // dynamically handle the route name for HR link
      $hr = \Drupal::entityTypeManager()->getStorage('node')->getQuery()
        ->condition('title', 'Human Resources – Services and Information', '=')
       ->execute();
      if ($hr) {
        $langcode = \Drupal\agri_admin\AgriAdminHelper::getLang();
        if (is_array($hr)) {
          $first_nid = array_shift($hr);
          $hr = \Drupal::entityTypeManager()->getStorage('node')->load($first_nid);
        }
        if ($hr->hasTranslation($langcode)) {
          $hr = $hr->getTranslation($langcode);
        }
        $linkHR = $hr->toLink(t('Human Resources'));
      }
      else {
        $linkHR = Link::createFromRoute(t('Human Resources'), 'view.view_employmentopportunities.page_1');
      }
      $breadcrumb->addLink($linkHR);
      $staffing = \Drupal::entityTypeManager()->getStorage('node')->getQuery()
        ->condition('title', 'Staffing', '=')
        ->execute();
      if (is_array($staffing)) {
        $first_nid = array_shift($staffing);
        $staffing = \Drupal::entityTypeManager()->getStorage('node')->load($first_nid);
      }
      if ($staffing) {
        $langcode = \Drupal\agri_admin\AgriAdminHelper::getLang();
        if ($staffing->hasTranslation($langcode)) {
          $staffing = $staffing->getTranslation($langcode);
        }
	$linkStaffing = $staffing->toLink($staffing->getTitle());
      }
      else {
        $linkStaffing = Link::createFromRoute(t('Staffing'), 'view.view_employmentopportunities.page_1');
      }
      $breadcrumb->addLink($linkStaffing);
    }
  }

  // logic is for rebuilding the Breadcrumb for the preview latest vesrion and authentication user to edit the page
  $regpath = '/\/node\/([1-9])\d*\/(latest|moderation-history|layout|delete|edit|revisions)/';
  $regpathlatest = '/\/node\/([1-9])\d*\/(latest|layout)/';
  $latest_bool = FALSE;
  if (preg_match($regpathlatest, $result)) {
    $latest_bool = TRUE;
  }
  if (preg_match($regpath, $result )) {
    $links = $breadcrumb->getlinks();
    $breadcrumb = new \Drupal\Core\Breadcrumb\Breadcrumb();
    $breadcrumb->addLink($links[0]);
    // www.drupal.org/node/2876622 addCacheContexts for new breadcrumb.
    $breadcrumb->addCacheContexts(['url.path', 'languages']);
    $tmpstr = explode('/', $result);
    if (isset($tmpstr[2]) && is_numeric($tmpstr[2])) {
      $nid = $tmpstr[2];
      $langcode = \Drupal\agri_admin\AgriAdminHelper::getLang();
      $url_alias = \Drupal::service('path_alias.manager')->getAliasByPath('/node/'. $nid, $langcode);
      $aliapthArray = explode('/', $url_alias);
      if ( $latest_bool) {
        // do not add the last menu item
        array_pop($aliapthArray);
      }
      $tmpPath = '';
      array_shift ($aliapthArray);
      foreach ($aliapthArray as $nodetitle) {
        $tmpPath =  $tmpPath . '/' . $nodetitle;
        $path = \Drupal::service('path_alias.manager')->getPathByAlias($tmpPath);
        $tmpnidarray = explode('/', $path);
        if (isset($tmpnidarray[2]) && is_numeric($tmpnidarray[2])) {
          $nid = $tmpnidarray[2];
          $link = \Drupal::entityTypeManager()->getStorage('node')->load($nid);
          if ($link) {
            if ($link->hasTranslation($langcode)) {
              $link = $link->getTranslation($langcode);
            }
            // retrieve Menu title based on langcode
            // i will move the query logic into the util class after the logic is tested on Cloud
            $system_uri = 'entity:node/' . $nid;
            $result = Utils::getMenuItemTitle($system_uri, $langcode);
            if (isset($result)) {
              $title = $result ;
            }
            else {
              // assign the default node title
              $title = $link->getTitle();
            }
            $linkNew = $link->toLink($title);
            if (isset ($linkNew)) {
              $breadcrumb->addLink($linkNew );
            }
          }
        }
      }
    }
  }
}

/**
 * Implements hook_preproces_breadcrumb.
 * for /node/add/news page
 */
function agri_admin_preprocess_breadcrumb(&$variables) {
  if ($variables['breadcrumb']) {
    $request = \Drupal::request();
    $route_match = \Drupal::routeMatch();
    $page_title = \Drupal::service('title_resolver')->getTitle($request, $route_match->getRouteObject());
    $current_path = \Drupal::service('path.current')->getPath();
    $result = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);

    if (!empty($page_title) && ($result =='/node/add/news') && (\Drupal::currentUser()->isAnonymous())) {
      $variables['breadcrumb'][] = [
        'text' => t('Submit an article for news at work'),
        'attributes' => new Drupal\Core\Template\Attribute(['class' => ['active']])
      ];
    }

    if (!empty($page_title) && ($result =='/node/add/empl') && (\Drupal::currentUser()->isAnonymous())) {
      $variables['breadcrumb'][] = [
        'text' => t('Internal Employment Opportunity Request Form'),
        'attributes' => new Drupal\Core\Template\Attribute(['class' => ['active']])
      ];
    }
  }
}


/**
 * Implements hook_preprocess_HOOK().
 */

function agri_admin_preprocess_field_multiple_value_form(&$vars) {
  if (!\Drupal::currentUser()->isAnonymous()) { return; }
  // Anonymous only logic below.

  // Remove weight option for multivalue fields.
  if (isset($vars['table']['#tabledrag'])) {
    unset($vars['table']['#tabledrag']);
    array_pop($vars['table']['#header']);
    foreach ($vars['table']['#rows'] as &$row) {
      foreach ($row['data'] as $key => $rowrowdata) {
        if (!$rowrowdata['data']) {
          unset($row['data'][$key]);
        }
      }
    }
  }
}

/**
 * Implements hook_preprocess_fieldset_HOOK().
 */

function agri_admin_preprocess_fieldset(&$variables) {
  unset($variables['attributes']['required']);
  unset($variables['attributes']['aria-required']);
  unset($variables['attributes']['aria-invalid']);
}

/**
 * Implements hook_preprocess_select_HOOK().
 */

function agri_admin_preprocess_select(&$variables) {
  if (!isset($variables['element']['#field_name'])) { return; }
  if (\Drupal::currentUser()->isAnonymous()) {
    if ($variables['element']['#field_name']) {
      if ($variables['element']['#field_name']== 'field_newstype') {
        $variables['attributes']['size'] = 1;
      }

      if ($variables['element']['#field_name']== 'field_to') {
        $variables['attributes']['size'] = 1;
      }

      if ($variables['element']['#field_name']== 'field_branch') {
        $variables['attributes']['size'] = 1;
      }

      if ($variables['element']['#field_name']== 'field_class_id') {
        $variables['attributes']['size'] = 1;
      }

      if ($variables['element']['#field_name']== 'field_class_sub') {
        $variables['attributes']['size'] = 1;
      }

      if ($variables['element']['#field_name']== 'field_class_level') {
        $variables['attributes']['size'] = 1;
      }
    }
  }
}

/**
 * Implements hook_preprocess_form_element_label_HOOK().
 */

function agri_admin_preprocess_form_element_label(&$variables) {
  if (\Drupal::currentUser()->isAnonymous()) {
    if ($variables['attributes']['for']) {
      if ($variables['attributes']['for'] == 'edit-advanced' ) {
        // This squelches w3c error for label that has no element.
        // Since we have removed edit-advanced section we also adjust its label.
        unset($variables['element']);
        unset($variables['attributes']['for']);
        unset($variables['attributes']['class']);
        $variables['attributes']['class'] = 'sr-only';
      }
    }
  }
}

/**
 * Implements hook_content_moderation_notification_mail_data_alter().
 */
function agri_admin_content_moderation_notification_mail_data_alter(Drupal\Core\Entity\EntityInterface $entity, array &$data) {
  $entitiyLang = $entity->get('langcode')->value;
  //avoid sending two emails for the same entity (en and fr) since the French information will be included in the English email
  if ($entitiyLang == 'en'){
    $currentModState = $entity->get('moderation_state')->getString();
    $nType = $entity->bundle();
    if ($nType == 'news'){
      //only send the email when the first draft is created
      if ($currentModState == 'draft' &&  \Drupal::currentUser()->isAnonymous()){
        $data['to'][] = $entity->get('field_newssubmitteremail')->value;
        $data['to'][] = $entity->get('field_newsreviewedby')->value;
        //The following emails will be read from the settings.local.php file if specified
        //news_generic_email: aafc.newsatwork-nouvellesalouvrage.aac@canada.ca on prod
        //and aafc.cmswebapps-sgcappsweb.aac@canada.ca on all other environments
        $data['to'][] = Settings::get('news_generic_email');
        $data['to'][] = Settings::get('comm_advisor_1');
        $data['to'][] = Settings::get('comm_advisor_2');
      }
      elseif ($currentModState == 'published'){
        //When publishing all recepients specified above will recieve an email except the comm_advisor_2
        $data['to'][] = $entity->get('field_newssubmitteremail')->value;
        $data['to'][] = $entity->get('field_newsreviewedby')->value;
        $data['to'][] = Settings::get('comm_advisor_1');
        $data['to'][] = Settings::get('news_generic_email');
      }
      else {
        $data['to'] = [];
      }
    }
    elseif ($nType == 'empl'){
      //only send the email when the first draft is created
      if ($currentModState == 'draft' &&  \Drupal::currentUser()->isAnonymous()){
        $data['to'][] = $entity->get('field_employmentrequestoremail')->value;
        //The following emails will be read from the settings.local.php file if specified
        //empl_generic_email: aafc.hrcentrerh.aac@canada.ca on prod
        //and aafc.cmswebapps-sgcappsweb.aac@canada.ca on all other environments
        $data['to'][] = Settings::get('empl_generic_email');
        //Get classification information to display in the email
        $classification   = '';
        if ($paragraph_field_items =  $entity->get('field_classification')->getValue()) {
          $paragraph_storage = \Drupal::entityTypeManager()->getStorage('paragraph');
          // Collect paragraph field's ids.
          $ids = array_column($paragraph_field_items, 'target_id');
          // Load all paragraph objects.
          $paragraphs_objects = $paragraph_storage->loadMultiple($ids);
          foreach ($paragraphs_objects as $paragraph) {
            // Get field from the paragraph.
            $groupval    = $paragraph->get('field_class_id')->value;
            $subgroupval = $paragraph->get('field_class_sub')->value;
            $levelval    = $paragraph->get('field_class_level')->value;
            $tmpText     = '';
            // Do something with $text...
            if ($subgroupval) {
              $tmpText = $groupval.'-'.$subgroupval.'-'.$levelval;
            }
            else {
              $tmpText = $groupval.'-'.$levelval;
            }
            if ( strlen($classification) >0 ) {
              $classification = $classification.', '. $tmpText;
            }
            else {
              $classification = $tmpText;
            }
          }
        }
        $emplMessage = "<p>Le français suit</p>
        <p>Your request ". "\""."<strong>[agri-admin:title]". ": (".$classification.")</strong>". "\"". " has been submitted and will be processed for publication on AgriSource by Human Resources within 2 working days.</p>" .
        "<p>To preview this opportunity, visit:&nbsp; [agri-admin:unpublished-url]</p>" .
        "<p>If you have any questions or concerns, please contact your&nbsp;<a data-auth='NotApplicable'
         href='http://intranet.agr.gc.ca/agrisourceprev/AgriDoc.do?id=1548432&amp;lang=eng' rel='noopener noreferrer'
         target='_blank'>Human Resource Advisor, Staffing.</a>
         <hr />
         <p>Votre demande relative à la possibilité d'emploi «&nbsp;<strong>[agri-admin:translation-title]". ": (".$classification.")</strong>&nbsp;» a été présentée et sera traitée aux fins de publication dans AgriSource par les Ressources humaines dans les deux jours ouvrables.</p>
         <p>Pour voir un aperçu de cette possibilité, consultez&nbsp;:&nbsp; [agri-admin:translation-unpublished-url]</p>" .
        "<p>Pour toute question ou préoccupation, veuillez communiquer avec votre&nbsp;<a data-auth='NotApplicable'
          href='http://intranet.agr.gc.ca/agrisourceprev/AgriDoc.do?id=1548428&amp;lang=fra' rel='noopener noreferrer'
          target='_blank'>conseiller(ère) en ressources humaines responsable de la dotation.</a>";

        $data['params']['subject'] = "Your employment opportunity " . "\"" . "[node:title]" . "\"" ." request has been submitted / Votre demande relative à la possibilité d'emploi «&nbsp;[agri-admin:translation-title]&nbsp;» a été présentée.";
        $data['params']['message'] = $emplMessage;
      }
      elseif ($currentModState != 'archived') {
        $data['to'] = [];
      }
    }
    //For basic and landing page CT, default email list will be used when publishing happens and no emails will be sent when drafts are created
    else {
      if ($currentModState == 'draft'){
        $data['to'] = [];
      }
    }
  }
  if ($entitiyLang == 'fr'){
    $data['to'] = [];
  }
}

/**
 * Implements hook_token_info().
 */
function agri_admin_token_info() {
  $info = [];
  $info['types']['agri-admin'] = ['name' => t('Agri Admin Custom Token'), 'description' => t('Custom Group to use in content moderation notification emails')];
  $info['tokens']['agri-admin']['translation-title'] = ['name' => t('Translation title'), 'description' => t('A token to extract the translated node title')];
  $info['tokens']['agri-admin']['translation-url'] = ['name' => t('Translation url'), 'description' => t('A token to extract the translated URL')];
  $info['tokens']['agri-admin']['title']  = ['name' => 'Title', 'description' => t('A token to extract the current title for news and employment opportunity when using submission form')];
  $info['tokens']['agri-admin']['url'] = ['name' => t('Url'), 'description' => t('A token to extract the current URL for news and employment opportunity when using submission form')];
  $info['tokens']['agri-admin']['unpublished-url'] = ['name' => t('Unpublished url'), 'description' => t('A token to extract the unpublished URL for news and employment opportunity for anonymous users')];
  $info['tokens']['agri-admin']['translation-unpublished-url'] = ['name' => t('Translation unpublished url'), 'description' => t('A token to extract the unpublished French URL for news and employment for anonymous users')];
  return $info;
}

/**
 * Implements hook_tokens().
 */
function  agri_admin_tokens($type, $tokens, array $data, array $options, \Drupal\Core\Render\BubbleableMetadata $bubbleable_metadata) {
  $replacements = [];
  if ($type == 'agri-admin' && isset($data['entity']) && $data['entity'] instanceof \Drupal\node\NodeInterface) {
    $entity = $data['entity'];
    if ($entity->hasTranslation('fr')) {
      $translated_entity = $entity->getTranslation('fr');
    }
    else {
      $translated_entity = $entity;
    }
    $translated_title = $translated_entity->getTitle();
    $translated_url = $translated_entity->toLink()->toString();
    $current_title = $entity->getTitle();
    $current_url = $entity->toLink()->toString();

    $currentLang = \Drupal::languageManager()->getCurrentLanguage();
    $hashTag = AgriAdminHelper::getHashTag($entity, $currentLang);
    $path = '<a href="'.$hashTag.'">'. $current_title.'</a>';
    $unpublished_url = \Drupal\Core\Render\Markup::create($path);

    $transLang = $translated_entity->language();
    $hashTagTrans = AgriAdminHelper::getHashTag($translated_entity, $transLang);
    $transPath = '<a href="'.$hashTagTrans.'">'. $translated_title.'</a>';
    $translated_unpublished_url = \Drupal\Core\Render\Markup::create($transPath);

    foreach ($tokens as $name => $original) {
      // Find the desired token by name.
      switch ($name) {
        case 'translation-title':
          $replacements[$original] = $translated_title;
          break;
        case 'translation-url':
          $replacements[$original] = $translated_url;
          break;
        case 'title':
          $replacements[$original] = $current_title;
          break;
        case 'url':
          $replacements[$original] = $current_url;
          break;
        case 'unpublished-url':
          $replacements[$original] = $unpublished_url;
          break;
        case 'translation-unpublished-url':
          $replacements[$original] = $translated_unpublished_url;
          break;
      }
    }
  }
  return $replacements;
}


/**
 * Implements hook_form_FORM_ID_alter.
 */

function agri_admin_form_menu_link_content_menu_link_content_form_alter (&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  if ($form_id = 'menu_link_content_menu_link_content_form') {
    //AgriAdminHelper::addToLog('form_id ' . $form_id, TRUE);
    $form['#attached']['library'][] = 'agri_admin/menu-navigation-hide-disabled'; // For hiding disabled items adding checkbox.
  }

  // TODO: convert this logic into a contrib module, BEGIN MENU EDIT/ADD LINK OPTIMISATION HERE:
  $route_match = Utils::getRouteName();
  $current_path = \Drupal::service('path.current')->getPath();
  // Retrieve an array which contains the path pieces.
  $path_args = explode('/', $current_path);
  $menu_link_add_or_edit_optimize = FALSE;
  $menu_name = '';

  if ($route_match == 'entity.menu.add_link_form' && isset($path_args[6])) {
    if ($path_args[4] == 'manage' && $path_args[6] == 'add') {
      $menu_link_add_or_edit_optimize = TRUE;
      $menu_name = $path_args[5] . ':';
    }
  }

  if ($route_match == 'entity.menu_link_content.canonical' && isset($path_args[6])) {
    if ($path_args[4] == 'item' && $path_args[6] == 'edit' && is_numeric($path_args[5])) {
      $mlid = $path_args[5];
      $link = AgriAdminHelper::getMenuLinkFromMlid($mlid);
      $menu_name = $link->getMenuName() . ':';
      $menu_link_add_or_edit_optimize = TRUE; // Always disable other menu items, speeds up logic for James logic.
//      $current_user = \Drupal::currentUser();
//      $current_user_id = $current_user->id();
//      $roles = $current_user->getRoles();
//      if (!in_array('administrator', $roles)) {
//        // Only non-Administrators should see the optimized menu for menu link EDIT because we want administrators to be able to move this link around if they wish.
//        $menu_link_add_or_edit_optimize = TRUE;
//      }
    }
  }
  if ($menu_link_add_or_edit_optimize) {
    foreach ($form['menu_parent']['#options'] as $key => &$value) {
      if (strpos($key, $menu_name) === FALSE) {
        unset($form['menu_parent']['#options'][$key]);
      }
      else {
        // Check interface lang code, if english, look for 'disabled' value, then if NOT disabled, call logic or function.
        // Check interface lang code, if french, look for 'désactivé' value, then if NOT désactivé, call logic or function.
        $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
        if ($langcode == 'en' && strpos($value, 'disabled') == false) {
          $keyarray = explode (":", $key);
          if ( sizeof($keyarray) > 2) {
            if ( AgriAdminHelper::isLinkFrenchOnly($keyarray[2])) {
               unset($form['menu_parent']['#options'][$key]);
            }
          }
        }
        else {
          if ($langcode == 'fr' && strpos($value, 'désactivé') == false) {
            $keyarray = explode (":", $key);
            if ( sizeof($keyarray) > 2) {
              if ( AgriAdminHelper::isLinkEnglishOnly($keyarray[2])) {
                unset($form['menu_parent']['#options'][$key]);
              }
            }
          }
        }
      }
    }
  }
  // TODO: END OF MENU EDIT/ADD LINK OPTIMISATION.

  foreach ($form['menu_parent']['#options'] as $key => &$value) {
    if ( strpos($value, '-- ') == 0  ) {
      //$value =  substr($value,0, 3) . 'level 1. ' . substr( $value,3, strlen($value)) ;
      $form['menu_parent']['#options_attributes'][$key]['class'] = ['class'=> 'menu_tree-leve-1'];
    }
    else {
      if ( strpos($value, '---- ') == 0  ) {
        // $value =  substr($value,0, 5) . 'level 2. ' . substr( $value,5, strlen($value)) ;
        $form['menu_parent']['#options_attributes'][$key]['class'] = 'menu_tree-leve-2 glyphicon';
      }
      else {
        if ( strpos($value, '------ ') == 0  ) {
          //$value =  substr($value,0, 7) . 'level 3. ' . substr( $value,7, strlen($value)) ;
          $form['menu_parent']['#options_attributes'][$key]['class'] = 'menu_tree-leve-3';
        }
        else {
          if ( strpos($value, '-------- ') == 0  ) {
            //$value =  substr($value,0, 9) . 'level 4. ' . substr( $value,9, strlen($value)) ;
            $form['menu_parent']['#options_attributes'][$key]['class'] = 'menu_tree-leve-4';
          }
          else {
            if ( strpos($value, '---------- ') == 0  ) {
              //$value =  substr($value,0, 11) . 'level 5. ' . substr( $value,11, strlen($value)) ;
              $form['menu_parent']['#options_attributes'][$key]['class'] = 'menu_tree-leve-5';
            }
            else {
              if ( strpos($value, '------------ ') == 0  ) {
                //$value =  substr($value,0, 13) . 'level 6. ' . substr( $value,11, strlen($value)) ;
                $form['menu_parent']['#options_attributes'][$key]['class'] = 'menu_tree-leve-6';
              }
            }
          }
        }
      }
    }
  }
}

/**
 * Implements agri_admin_views_pre_view hook
 */

function agri_admin_views_pre_view (ViewExecutable $view, $display_id, $args) {
  if ( $view->id() != 'content' && $view->id() != 'moderated_content' ) {
    return;
  }

  $user_roles = \Drupal::currentUser()->getRoles();
  if (in_array('empl_cspub', $user_roles)) {
    $filters = $view->getDisplay()->getOption('filters');
    $filters['type']['value'] = 'empl';
    $view->display_handler->overrideOption('filters', $filters);
  }

  if (in_array('news_ccpub', $user_roles)) {
    $filters = $view->getDisplay()->getOption('filters');
    $filters['type']['value'] = 'news';
    $view->display_handler->overrideOption('filters', $filters);
  }
}

/**
 * Implements agri_admin_form_views_exposed_form_alter hook.
 */

function agri_admin_form_views_exposed_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $view = $form_state->getStorage('view');
  if ($view['view']->id() != 'content' && $view['view']->id() != 'moderated_content' ) {
    return;
  }

  $user_roles = \Drupal::currentUser()->getRoles();
  if (in_array('empl_cspub', $user_roles) && ($form_id == 'views_exposed_form')) {
    foreach ($form['type']['#options'] as $key => &$value) {
      if ($key != 'empl') {
        unset($form['type']['#options'][$key]);
      }
    }
  }

  if (in_array('news_ccpub', $user_roles) && ($form_id == 'views_exposed_form')) {
    foreach ($form['type']['#options'] as $key => &$value) {
      if ($key != 'news') {
        unset($form['type']['#options'][$key]);
      }
    }
  }
}


/**
 * Implements hook_file_validate().
 */
function agri_admin_file_validate(FileInterface $file) {
  if (!(\Drupal::config('filehash.settings')->get('dedupe'))) {
    agri_admin_validate_dedupe_warning($file);
  }
}


/**
 * Checks that file is not a duplicate.
 */
function agri_admin_validate_dedupe_warning(FileInterface $file) {
  $warnings = [];
  $warning = '';
  $langId = \Drupal::languageManager()->getCurrentLanguage()->getId();
  if (!$file->id()) {
    foreach (agri_admin_algos() as $algo) {
      $query = \Drupal::database()->select('filehash');
      $query->addField('filehash', 'fid');
      $query->condition($algo, $file->filehash[$algo]);
      $query->range(0, 1);
      if ($fid = $query->execute()->fetchField()) {
        if (\Drupal::currentUser()->hasPermission('access files overview')) {
          try {
            $url = Url::fromRoute('view.files.page_2', ['arg_0' => $fid], ['attributes' => ['target' => '_blank']]);
            $filename = Link::fromTextAndUrl(File::load($fid)->label(), $url)->toString();
            if ($langId == 'en') {
              $warning = Markup::create('This file has already been uploaded as ' . $filename . '.');
            }
            else {
              $warning = Markup::create('Ce fichier a déjà été téléchargé en tant que ' . $filename . '.');
            }
          }
          catch (Exception $e) {
            // Maybe the view was disabled?
            \Drupal::messenger()->addWarning($e->getMessage(),TRUE);
          }
        }
        else {
          if ($langId == 'en') {
            $warning = 'This file has already been uploaded.';
          }
          else {
            $warning = 'Ce fichier a déjà été téléchargé.';
          }
        }
        array_push($warnings, $warning);
        break;
      }
    }
  }
  //out put all warning messages
  foreach($warnings as $msg) {
    \Drupal::messenger()->addWarning($msg,TRUE);
  }
  return [];
}


/**
 * Returns array of enabled hash algorithms.
 */
function agri_admin_algos() {
  return array_diff(\Drupal::config('filehash.settings')->get('algos'), [0]);
}
